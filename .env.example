# Copy to .env.local (gitignored). The #3 and #4 setup wizards fill these in.
# .env.local holds the dev values; Vercel holds Preview (dev) and Production (prod).

# Supabase (Decisions 12, 13). Preview and .env.local: cachedrop-dev. Production: cachedrop-prod.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Postgres session-pooler connection strings, for migrations only. .env.local only, never Vercel.
SUPABASE_DEV_DB_URL=
SUPABASE_PROD_DB_URL=

# Cloudflare Turnstile (Decision 12). Preview and .env.local use Cloudflare's always-pass test keys.
# With the always-pass secret outside Production, tests may send `x-turnstile-test: fail|spent` to
# swap in Cloudflare's always-fail or spent-token secret, and `x-rate-limit-key: <anything>` to be
# counted under their own rate-limit key instead of their IP (src/server/bot-check.ts). Production
# holds the real secret and ignores both. An unset site key builds with the always-pass test key,
# except on a Vercel Production build, which fails.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Fine-grained token: mac-cleaner only, Issues read and write (Decision 8).
GITHUB_FEEDBACK_TOKEN=

# Resend (Decision 14), sending access for cachedrop.io only.
RESEND_API_KEY=
# Test mode for the email gate (Decision 27). Preview only: 1 lets a signup request with the
# `x-capture-email: 1` header get the download email back instead of it being sent, so Playwright
# can read the link. Production never captures, whatever this says. Leave unset everywhere else.
CAPTURE_EMAIL=
