---
// The homepage, built at / and at /fr/ (Decision 5). The markup is shared; `copy` holds each
// language's strings. Strings rendered with set:html carry inline markup (a line break, a code span).
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AppWindow from '../../components/AppWindow.astro';
import { langOf, langPaths, localize } from '../../i18n';

export const getStaticPaths = langPaths;

const copy = {
  en: {
    title: 'Mac Storage Cleaner – Free Up Space on Your Mac | CacheDrop',
    description: 'Free up space on your Mac. CacheDrop finds hidden caches, Xcode DerivedData, node_modules and video caches, and clears them safely. Free beta.',
    operatingSystem: 'macOS 14 or later',
    badge: 'Free Mac storage cleaner · Public beta',
    h1: 'Store less junk.<br>Keep what matters.',
    lede: 'Your Mac is full of invisible caches, derived data, and abandoned project files. CacheDrop safely finds them and drops them. Free up space on your Mac in seconds.',
    download: 'Download Free Beta',
    feedback: 'Give Fast Feedback',
    meta: 'Free for a limited time · Help us build it · macOS 14+ on Apple Silicon & Intel',
    featuresEyebrow: 'Built for workstations',
    featuresTitle: 'Built for the heavy lifters.',
    featuresBody: 'CacheDrop is a Mac storage cleaner made for developers and video editors. Generic cleaners clear browser cookies and miss the real weight. CacheDrop goes after compiler caches, media caches and stale container images: the files that grow quietly with every project.',
    developers: {
      title: 'Clear Developer Junk',
      body: 'Drop gigabytes of forgotten <span class="mono" style="font-size: 13px">node_modules</span>, Xcode DerivedData, and Docker caches safely.',
      chips: ['node_modules', 'DerivedData', 'Docker images'],
      link: 'How to clear developer caches',
    },
    creators: {
      title: 'Clear Creator Caches',
      body: 'Clear hidden Adobe media caches and size up Final Cut Pro libraries full of render files, without losing your timelines.',
      chips: ['.cfa / .pek', 'Media Cache', 'FCPX Libraries'],
      link: 'How to clear Adobe media cache',
    },
    disk: {
      title: 'Reclaim Mac Disk Space',
      body: 'Safely purge massive application logs, app caches, and leftover update downloads clogging your hard drive.',
      chips: ['~/Library/Caches', '~/Library/Logs', 'Update downloads'],
    },
    carefulEyebrow: 'Careful by default',
    carefulTitle: 'Nothing leaves your Mac without a look.',
    carefulBody: 'Old-school cleaners run blunt scripts across standard folders. CacheDrop shows you what it found, why it’s safe to drop, and how much you’ll get back. Then it waits for you.',
    steps: [
      ['Only what tools rebuild', 'Package caches, build files and render data that your apps regenerate on their own. Your code, projects and timelines stay put.'],
      ['You review first', 'Every recommendation shows its size and where it lives before anything moves.'],
      ['Your files go to the Trash', 'Caches that apps rebuild are deleted. Your files go to the Trash, so changing your mind is one drag away.'],
    ],
    faqTitle: 'Mac storage, answered.',
    faqAsk: 'Still have a question? <a class="textlink" href="#feedback" data-feedback style="color: var(--accent-text)">Ask us directly</a>.',
    // One list feeds both the visible FAQ and the FAQPage JSON-LD, so they can't drift apart.
    faq: [
      ['What is CacheDrop?', 'CacheDrop is a native Mac storage cleaner for developers and video editors. It finds hidden caches, Xcode DerivedData, old node_modules folders and video editing caches, shows how much space each one takes, and clears what you approve.'],
      ['How do I free up space on my Mac?', 'Start with the files you can’t see. Caches, build files and render data can take tens of gigabytes, and macOS hides them inside “System Data”. CacheDrop scans for them, lets you review what it found, and clears it when you confirm.'],
      ['What is System Data on a Mac, and can I delete it?', 'System Data is where macOS counts files that don’t fit its other categories, including app caches, logs and developer build files. Much of it is safe to remove because apps rebuild it. CacheDrop only targets those rebuildable parts.'],
      ['Is it safe to delete caches on a Mac?', 'Yes, for caches that apps regenerate: the app simply rebuilds them the next time it needs them. CacheDrop recommends caches that rebuild themselves and shows you each one before anything is cleared.'],
      ['How do I clear my Mac’s disk without losing files?', 'Clear caches and build output, not documents. CacheDrop leaves your code, projects and timelines alone. It deletes only files apps make again, like caches, and sends your own files to the Trash.'],
      ['Is CacheDrop free, and which Macs does it support?', 'It’s free for a limited time during the public beta. It’s a universal app for Apple Silicon and Intel Macs running macOS 14 Sonoma or later.'],
    ],
    closingTitle: 'Get your space back.',
    closingBody: 'Free while in beta. One universal app for Apple Silicon and Intel Macs on macOS 14 or later.',
    closingLink: 'Using it already? Tell us what to fix next →',
  },
  fr: {
    title: 'Nettoyer son Mac – Libérez de l’espace de stockage | CacheDrop',
    description: 'Libérez de l’espace sur votre Mac. CacheDrop repère les caches invisibles, les DerivedData de Xcode, les dossiers node_modules et les caches vidéo, puis les vide en toute sécurité. Bêta gratuite.',
    operatingSystem: 'macOS 14 ou version ultérieure',
    badge: 'Nettoyeur gratuit pour Mac · Bêta publique',
    h1: 'Moins de superflu.<br>Gardez l’essentiel.',
    lede: 'Votre Mac est rempli de caches invisibles, de données dérivées et de fichiers de projets abandonnés. CacheDrop les repère et les supprime en toute sécurité. Libérez de l’espace sur votre Mac en quelques secondes.',
    download: 'Télécharger la bêta gratuite',
    feedback: 'Donner votre avis',
    meta: 'Gratuit pour une durée limitée · Aidez-nous à le bâtir · macOS 14+ sur Apple Silicon et Intel',
    featuresEyebrow: 'Conçu pour les postes de travail',
    featuresTitle: 'Fait pour les gros travaux.',
    featuresBody: 'CacheDrop est un nettoyeur de stockage pour Mac conçu pour les développeurs et les monteurs vidéo. Les nettoyeurs génériques effacent les témoins du navigateur et passent à côté de ce qui pèse vraiment. CacheDrop s’attaque aux caches de compilation, aux caches de média et aux vieilles images de conteneurs : les fichiers qui grossissent en silence à chaque projet.',
    developers: {
      title: 'Vider les fichiers de développement',
      body: 'Supprimez en toute sécurité des gigaoctets de dossiers <span class="mono" style="font-size: 13px">node_modules</span> oubliés, de DerivedData de Xcode et de caches Docker.',
      chips: ['node_modules', 'DerivedData', 'Images Docker'],
      link: 'Comment vider les caches de développement',
    },
    creators: {
      title: 'Vider les caches de création',
      body: 'Videz les caches de média Adobe invisibles et mesurez les bibliothèques Final Cut Pro remplies de fichiers de rendu, sans perdre vos montages.',
      chips: ['.cfa / .pek', 'Cache de média', 'Bibliothèques FCPX'],
      link: 'Comment vider le cache de média Adobe',
    },
    disk: {
      title: 'Récupérer de l’espace disque',
      body: 'Purgez en toute sécurité les énormes journaux d’applications, les caches d’applications et les téléchargements de mises à jour restants qui encombrent votre disque.',
      chips: ['~/Library/Caches', '~/Library/Logs', 'Mises à jour téléchargées'],
    },
    carefulEyebrow: 'Prudent par défaut',
    carefulTitle: 'Rien ne quitte votre Mac sans que vous l’ayez vu.',
    carefulBody: 'Les nettoyeurs d’ancienne génération lancent des scripts sans nuance sur des dossiers standards. CacheDrop vous montre ce qu’il a trouvé, pourquoi on peut le supprimer sans risque et combien d’espace vous récupérerez. Puis il attend votre feu vert.',
    steps: [
      ['Seulement ce que vos outils recréent', 'Les caches de paquets, les fichiers de compilation et les données de rendu que vos applications régénèrent d’elles-mêmes. Votre code, vos projets et vos montages restent en place.'],
      ['Vous vérifiez d’abord', 'Chaque recommandation indique sa taille et son emplacement avant que quoi que ce soit ne bouge.'],
      ['Vos fichiers vont à la Corbeille', 'Les caches que les applications recréent sont supprimés. Vos fichiers vont à la Corbeille, d’où vous pouvez les récupérer d’un simple glisser.'],
    ],
    faqTitle: 'Le stockage du Mac, expliqué.',
    faqAsk: 'Une autre question? <a class="textlink" href="#feedback" data-feedback style="color: var(--accent-text)">Écrivez-nous directement</a>.',
    faq: [
      ['Qu’est-ce que CacheDrop?', 'CacheDrop est un nettoyeur de stockage natif pour Mac, conçu pour les développeurs et les monteurs vidéo. Il repère les caches invisibles, les DerivedData de Xcode, les vieux dossiers node_modules et les caches de montage vidéo, montre l’espace qu’occupe chacun et vide ce que vous approuvez.'],
      ['Comment libérer de l’espace sur mon Mac?', 'Commencez par les fichiers que vous ne voyez pas. Les caches, les fichiers de compilation et les données de rendu peuvent occuper des dizaines de gigaoctets, et macOS les dissimule dans « Données système ». CacheDrop les repère, vous laisse vérifier ce qu’il a trouvé et les vide quand vous confirmez.'],
      ['Que sont les Données système d’un Mac, et puis-je les supprimer?', 'Les Données système regroupent les fichiers que macOS ne classe dans aucune autre catégorie, dont les caches d’applications, les journaux et les fichiers de compilation des développeurs. Une bonne partie peut être supprimée sans risque, car les applications la recréent. CacheDrop ne cible que ces parties recréables.'],
      ['Peut-on supprimer les caches d’un Mac sans risque?', 'Oui, pour les caches que les applications régénèrent : l’application les recrée simplement la prochaine fois qu’elle en a besoin. CacheDrop recommande les caches qui se recréent d’eux-mêmes et vous montre chacun d’eux avant de vider quoi que ce soit.'],
      ['Comment faire de la place sur le disque de mon Mac sans perdre de fichiers?', 'Videz les caches et les produits de compilation, pas vos documents. CacheDrop ne touche pas à votre code, à vos projets ni à vos montages. Il supprime seulement les fichiers que les applications recréent, comme les caches, et envoie vos propres fichiers à la Corbeille.'],
      ['CacheDrop est-il gratuit, et sur quels Mac fonctionne-t-il?', 'Il est gratuit pour une durée limitée pendant la bêta publique. C’est une application universelle pour les Mac Apple Silicon et Intel sous macOS 14 Sonoma ou version ultérieure.'],
    ],
    closingTitle: 'Récupérez votre espace.',
    closingBody: 'Gratuit pendant la bêta. Une seule application universelle pour les Mac Apple Silicon et Intel sous macOS 14 ou version ultérieure.',
    closingLink: 'Vous l’utilisez déjà? Dites-nous quoi corriger en premier →',
  },
};
const lang = langOf(Astro.url);
const t = copy[lang];
const download = localize(lang, '/download/');

const site = Astro.site!.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site}/#org`, name: 'CacheDrop', url: `${site}/`, logo: `${site}/assets/cachedrop-app-icon.png` },
    {
      '@type': 'SoftwareApplication',
      name: 'CacheDrop',
      url: `${site}${localize(lang, '/')}`,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: t.operatingSystem,
      description: t.description,
      publisher: { '@id': `${site}/#org` },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
    },
  ],
};

const card = 'background: var(--surface-raised); border: 1px solid var(--line); border-radius: var(--radius-2xl); padding: var(--space-8); box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: var(--space-6)';
const tile = 'width: var(--tile-md); height: var(--tile-md); border-radius: var(--radius-lg); background: var(--surface-subtle); display: flex; align-items: center; justify-content: center; color: var(--ink)';
const chip = 'font-size: 12px; color: var(--ink-body); background: var(--surface-subtle); border-radius: var(--radius-xs); padding: var(--space-1) var(--space-2)';
const chips = 'display: flex; flex-wrap: wrap; gap: var(--space-1-5); padding-top: var(--space-5); border-top: 1px solid var(--line)';
const cardTitle = 'margin: 0; font-size: 18px; line-height: 24px; font-weight: 600; letter-spacing: -0.01em';
const cardBody = 'margin: var(--space-2) 0 0; font-size: 15px; line-height: 23px; color: var(--ink-soft)';
const cardLink = 'display: inline-flex; align-items: center; gap: var(--space-1-5); font-size: 14px; font-weight: 500; color: var(--accent-text)';
const eyebrow = 'margin: 0 0 var(--space-3); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-secondary)';
const sectionH2 = 'margin: 0; font-size: clamp(28px, 3.4vw, 40px); line-height: 1.2; font-weight: 600; letter-spacing: -0.025em';
const primaryLg = 'display: inline-flex; align-items: center; gap: var(--space-2-5); height: var(--control-lg); padding: 0 var(--space-6); border-radius: var(--radius-full); background: var(--accent); font-size: 15px; font-weight: 500; box-shadow: var(--shadow-button)';
const steps = t.steps.map(([title, body], i) => [`0${i + 1}`, title, body]);
---
<Base title={t.title} description={t.description} path="/" jsonLd={jsonLd}>
<Nav homeHref="#top" />

<section id="top" style="max-width: var(--container-max); margin: 0 auto; padding: var(--space-28) var(--space-6) var(--space-32); display: flex; flex-direction: column; align-items: center; text-align: center">
<p style="margin: 0 0 var(--space-8); display: inline-flex; align-items: center; gap: var(--space-2); font-size: 12px; font-weight: 500; color: var(--ink-secondary); padding: var(--space-1-5) var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-full); background: var(--surface-elevated)">
<span aria-hidden="true" style="width: var(--dot); height: var(--dot); border-radius: var(--radius-full); background: var(--success)"></span>
<span>{t.badge}</span>
</p>
<h1 style="margin: 0; font-size: clamp(40px, 6vw, 76px); line-height: 1.04; font-weight: 600; letter-spacing: -0.04em; text-wrap: balance" set:html={t.h1} />
<h2 style="margin: var(--space-7) 0 0; max-width: var(--lede-max); font-size: 19px; line-height: 29px; font-weight: 400; letter-spacing: -0.012em; color: var(--ink-secondary); text-wrap: pretty">{t.lede}</h2>
<div id="download" style="margin-top: var(--space-10); display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-3)">
<a class="btn-primary" href={download} style={primaryLg}>
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
<span>{t.download}</span>
</a>
<a class="btn-ghost" href="#feedback" data-feedback style="display: inline-flex; align-items: center; height: var(--control-lg); padding: 0 22px; border-radius: var(--radius-full); border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); font-size: 15px; font-weight: 500">{t.feedback}</a>
</div>
<p style="margin: 18px 0 0; font-size: 13px; color: var(--ink-secondary)">{t.meta}</p>

<AppWindow />
</section>

<section id="features" style="background: var(--surface-subtle); padding: var(--space-30) var(--space-6)">
<div style="max-width: var(--container-max); margin: 0 auto">
<div style="max-width: var(--lede-max); margin-bottom: var(--space-14)">
<p style={eyebrow}>{t.featuresEyebrow}</p>
<h2 style={sectionH2}>{t.featuresTitle}</h2>
<p style="margin: var(--space-4) 0 0; font-size: 17px; line-height: 27px; color: var(--ink-secondary); text-wrap: pretty">{t.featuresBody}</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: var(--space-6)">

<article id="developers" style={card}>
<div style={tile}>
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M7 10l3 2-3 2"></path><path d="M13 15h4"></path></svg>
</div>
<div style="flex: 1">
<h3 style={cardTitle}>{t.developers.title}</h3>
<p style={cardBody} set:html={t.developers.body} />
</div>
<div style={chips}>
{t.developers.chips.map((c) => <span class="mono" style={chip}>{c}</span>)}
</div>
<a class="textlink" href={localize(lang, '/clear-mac-developer-caches/')} style={cardLink}>{t.developers.link}
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
</article>

<article id="creators" style={card}>
<div style={tile}>
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M10 9.5v5l4.5-2.5z"></path></svg>
</div>
<div style="flex: 1">
<h3 style={cardTitle}>{t.creators.title}</h3>
<p style={cardBody}>{t.creators.body}</p>
</div>
<div style={chips}>
{t.creators.chips.map((c) => <span class="mono" style={chip}>{c}</span>)}
</div>
<a class="textlink" href={localize(lang, '/clear-adobe-media-cache-mac/')} style={cardLink}>{t.creators.link}
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
</article>

<article style={card}>
<div style={tile}>
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="10" rx="3"></rect><path d="M11 12h6"></path><path d="M7 12h.01"></path></svg>
</div>
<div style="flex: 1">
<h3 style={cardTitle}>{t.disk.title}</h3>
<p style={cardBody}>{t.disk.body}</p>
</div>
<div style={chips}>
{t.disk.chips.map((c) => <span class="mono" style={chip}>{c}</span>)}
</div>
</article>

</div>
</div>
</section>

<section style="padding: var(--space-32) var(--space-6)">
<div style="max-width: var(--container-max); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: var(--space-16); align-items: start">
<div>
<p style={eyebrow}>{t.carefulEyebrow}</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.carefulTitle}</h2>
<p style="margin: var(--space-4) 0 0; max-width: 440px; font-size: 17px; line-height: 27px; color: var(--ink-secondary); text-wrap: pretty">{t.carefulBody}</p>
</div>
<ol style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column">
{steps.map(([n, title, body], i) => (
<li style={`display: flex; gap: var(--space-6); padding: var(--space-7) 0; border-top: 1px solid var(--line)${i === steps.length - 1 ? '; border-bottom: 1px solid var(--line)' : ''}`}>
<span class="mono" style="flex: none; width: var(--control-xs); font-size: 13px; line-height: 24px; color: var(--ink-secondary)">{n}</span>
<div>
<h3 style={cardTitle}>{title}</h3>
<p style="margin: var(--space-1-5) 0 0; font-size: 15px; line-height: 23px; color: var(--ink-soft)">{body}</p>
</div>
</li>
))}
</ol>
</div>
</section>

<section id="faq" style="padding: 0 var(--space-6) var(--space-32)">
<div style="max-width: var(--container-max); margin: 0 auto; padding-top: var(--space-28); border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: var(--space-16); align-items: start">
<div>
<p style={eyebrow}>FAQ</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.faqTitle}</h2>
<p style="margin: var(--space-4) 0 0; max-width: 400px; font-size: 17px; line-height: 27px; color: var(--ink-secondary)" set:html={t.faqAsk} />
</div>
<div style="display: flex; flex-direction: column">
{t.faq.map(([q, a], i) => (
<div style={`padding: var(--space-6) 0; border-top: 1px solid var(--line)${i === t.faq.length - 1 ? '; border-bottom: 1px solid var(--line)' : ''}`}>
<h3 style="margin: 0; font-size: 18px; line-height: 26px; font-weight: 600; letter-spacing: -0.01em">{q}</h3>
<p style="margin: var(--space-2) 0 0; font-size: 15px; line-height: 24px; color: var(--ink-soft)">{a}</p>
</div>
))}
</div>
</div>
</section>

<section style="background: var(--surface-subtle); padding: var(--space-30) var(--space-6); text-align: center">
<div style="max-width: 640px; margin: 0 auto; display: flex; flex-direction: column; align-items: center">
<h2 style="margin: 0; font-size: clamp(32px, 4.4vw, 52px); line-height: 1.1; font-weight: 600; letter-spacing: -0.035em">{t.closingTitle}</h2>
<p style="margin: 18px 0 0; font-size: 17px; line-height: 27px; color: var(--ink-secondary)">{t.closingBody}</p>
<a class="btn-primary" href={download} style={`margin-top: 36px; ${primaryLg}`}>
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
<span>{t.download}</span>
</a>
<a class="textlink" href="#feedback" data-feedback style="margin-top: var(--space-5); font-size: 14px; color: var(--ink-body)">{t.closingLink}</a>
</div>
</section>

<Footer path="/" />
</Base>
