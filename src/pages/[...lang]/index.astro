const lang = langOf(Astro.url);
const t = copy[lang];
const download = localize(lang, '/download/');

const site = Astro.site!.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site}/#org`, name: 'CacheDrop', url: `${site}/`, logo: `${site}/assets/cachedrop-app-icon.png` },
    {
      '@type': 'SoftwareApplication',
      name: 'CacheDrop',
      url: `${site}${localize(lang, '/')}`,
      applicationCategory: 'UtilitiesApplication',
      dateModified: lastModified(`${site}${localize(lang, '/')}`),
      operatingSystem: t.operatingSystem,
      processorRequirements: 'Apple Silicon, Intel',
      description: t.description,
      // Decision 51's fact sheet, in the words of the pricing card.
      featureList: pricingCopy[lang].items,
      publisher: { '@id': `${site}/#org` },
      // Decision 47: the price a buyer pays today, with the regular price as the struck-through one
      // while the limited-time offer runs (schema.org StrikethroughPrice).
      offers: {
        '@type': 'Offer',
        price: price.offer,
        priceCurrency: 'USD',
        ...(discounted && {
          priceSpecification: { '@type': 'UnitPriceSpecification', priceType: 'https://schema.org/StrikethroughPrice', price: price.regular, priceCurrency: 'USD' },
        }),
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
    },
  ],
};

const tile = 'width: var(--tile-md); height: var(--tile-md); border-radius: var(--radius-lg); background: var(--surface-subtle); display: flex; align-items: center; justify-content: center; color: var(--ink)';
const chip = 'font-size: 12px; color: var(--ink-body); background: var(--surface-subtle); border-radius: var(--radius-xs); padding: var(--space-1) var(--space-2)';
const chips = 'display: flex; flex-wrap: wrap; gap: var(--space-1-5); padding-top: var(--space-5); border-top: 1px solid var(--line)';
const cardBody = 'margin: var(--space-2) 0 0; font-size: 15px; line-height: 23px; color: var(--ink-soft)';
const cardLink = 'display: inline-flex; align-items: center; gap: var(--space-1-5); font-size: 14px; font-weight: 500; color: var(--accent-text)';
const lede = 'margin: var(--space-4) 0 0; font-size: 17px; line-height: 27px; color: var(--ink-secondary); text-wrap: pretty';
const grid = 'display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: var(--space-6)';
const twoColumns = 'max-width: var(--container-max); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: var(--space-16); align-items: start';
const steps = t.steps.map(([title, body], i) => [`0${i + 1}`, title, body]);

// The value props' icons: a disk with its fill, an app box with an arrow out, a tick in a shield.
const valueIcons = [
  '<rect x="3" y="7" width="18" height="10" rx="3"></rect><path d="M11 12h6"></path><path d="M7 12h.01"></path>',
  '<rect x="4" y="4" width="16" height="16" rx="4"></rect><path d="M12 8v8"></path><path d="M8.5 12.5L12 16l3.5-3.5"></path>',
  '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"></path><path d="M9 12l2 2 4-4"></path>',
];
// The work cards: a waveform, a terminal, a play button.
const work = [
  { id: 'producers', ...t.producers, href: guides.producer.path, icon: '<path d="M4 12h2"></path><path d="M8 8v8"></path><path d="M12 5v14"></path><path d="M16 9v6"></path><path d="M20 11v2"></path>' },
  { id: 'developers', ...t.developers, href: guides.developer.path, icon: '<rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M7 10l3 2-3 2"></path><path d="M13 15h4"></path>' },
  { id: 'editors', ...t.editors, href: guides.creator.path, icon: '<rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M10 9.5v5l4.5-2.5z"></path>' },
];
---
<Base title={t.title} description={t.description} path="/" jsonLd={jsonLd}>
<Nav homeHref="#top" />

<section id="top" style="max-width: var(--container-max); margin: 0 auto; padding: var(--space-28) var(--space-6) var(--space-32); display: flex; flex-direction: column; align-items: center; text-align: center">
<p data-proof style="margin: 0 0 var(--space-8); display: inline-flex; align-items: center; gap: var(--space-2); font-size: 12px; font-weight: 500; color: var(--ink-secondary); padding: var(--space-1-5) var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-full); background: var(--surface-elevated)">
<span aria-hidden="true" style="width: var(--dot); height: var(--dot); border-radius: var(--radius-full); background: var(--success)"></span>
<span>{t.proof}</span>
</p>
<h1 style="margin: 0; font-size: clamp(40px, 6vw, 76px); line-height: 1.04; font-weight: 600; letter-spacing: -0.04em; text-wrap: balance">{t.h1}</h1>
<p style="margin: var(--space-7) 0 0; max-width: var(--lede-max); font-size: 19px; line-height: 29px; font-weight: 400; letter-spacing: -0.012em; color: var(--ink-secondary); text-wrap: pretty">{t.lede}</p>
<div id="download" style="margin-top: var(--space-10); display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-3)">
<a class="btn-primary" href={download} style={primaryLg}>
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
<span>{t.download}</span>
</a>
<BuyButton variant="ghost" />
</div>
<p style="margin: 18px 0 0; font-size: 13px; color: var(--ink-secondary)">{pricingCopy[lang].trial}</p>

<AppWindow />
</section>

<section id="value" style="padding: 0 var(--space-6) var(--space-30)">
<div style="max-width: var(--container-max); margin: 0 auto">
<div style="max-width: var(--lede-max); margin-bottom: var(--space-14)">
<p style={eyebrow}>{t.valueEyebrow}</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.valueTitle}</h2>
</div>
<div style={grid}>
{t.values.map(([title, body], i) => (
<div style="display: flex; flex-direction: column; gap: var(--space-5)">
<div style={tile}>
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={valueIcons[i]} />
</div>
<div>
<h3 style={titleMd}>{title}</h3>
<p style={cardBody}>{body}</p>
</div>
</div>
))}
</div>
</div>
</section>

<section id="work" style="background: var(--surface-subtle); padding: var(--space-30) var(--space-6)">
<div style="max-width: var(--container-max); margin: 0 auto">
<div style="max-width: var(--lede-max); margin-bottom: var(--space-14)">
<p style={eyebrow}>{t.workEyebrow}</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.workTitle}</h2>
<p style={lede}>{t.workBody}</p>
</div>
<div style={grid}>
{work.map((w) => (
<article id={w.id} style={card}>
<div style={tile}>
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={w.icon} />
</div>
<div style="flex: 1">
<h3 style={titleMd}>{w.title}</h3>
<p style={cardBody} set:html={w.body} />
</div>
<div style={chips}>
{w.chips.map((c) => <span class="mono" style={chip}>{c}</span>)}
</div>
<a class="textlink" href={localize(lang, w.href)} style={cardLink}>{w.link}
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
</article>
))}
</div>
</div>
</section>

<section id="safe" style="padding: var(--space-32) var(--space-6)">
<div style={twoColumns}>
<div>
<p style={eyebrow}>{t.safeEyebrow}</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.safeTitle}</h2>
<p style={`${lede}; max-width: 440px`}>{t.safeBody}</p>
</div>
<ol style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column">
{steps.map(([n, title, body], i) => (
<li style={`display: flex; gap: var(--space-6); padding: var(--space-7) 0; border-top: 1px solid var(--line)${i === steps.length - 1 ? '; border-bottom: 1px solid var(--line)' : ''}`}>
<span class="mono" style="flex: none; width: var(--control-xs); font-size: 13px; line-height: 24px; color: var(--ink-secondary)">{n}</span>
<div>
<h3 style={titleMd}>{title}</h3>
<p style="margin: var(--space-1-5) 0 0; font-size: 15px; line-height: 23px; color: var(--ink-soft)">{body}</p>
</div>
</li>
))}
</ol>
</div>
</section>

<PricingSection versus />

<section id="faq" style="padding: 0 var(--space-6) var(--space-32)">
<div style={`${twoColumns}; padding-top: var(--space-28); border-top: 1px solid var(--line)`}>
<div>
<p style={eyebrow}>FAQ</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.faqTitle}</h2>
<p style="margin: var(--space-4) 0 0; max-width: 400px; font-size: 17px; line-height: 27px; color: var(--ink-secondary)" set:html={t.faqAsk} />
</div>
<div style="display: flex; flex-direction: column">
{t.faq.map(([q, a], i) => (
<div style={faqItem(i, t.faq.length)}>
<h3 style={faqQuestion}>{q}</h3>
<p style="margin: var(--space-2) 0 0; font-size: 15px; line-height: 24px; color: var(--ink-soft)">{a}</p>
</div>
))}
</div>
</div>
</section>

<ClosingCta size="home" title={t.closingTitle} body={t.closingBody} href={download} cta={t.download} />

<Footer path="/" />
</Base>
