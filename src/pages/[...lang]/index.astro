---
// The homepage, built at / and at /fr/ (Decision 5), in the order Decision 51 sets (#109): the hero,
// three value props, "Made for your work", "Safe by design", "Pay once" (the pricing section), the FAQ
// and the closing call to action. "Kept up to date" waits for the update feed (#122). The markup is
// shared; `copy` holds each language's strings. Strings rendered with set:html carry inline markup.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AppWindow from '../../components/AppWindow.astro';
import BuyButton from '../../components/BuyButton.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import PricingSection from '../../components/PricingSection.astro';
import { discounted, price, pricingCopy } from '../../components/pricing';
import { card, eyebrow, faqItem, faqQuestion, primaryLg, sectionH2, titleMd } from '../../components/guide-styles';
import { guides } from '../../components/guides';
import { lastModified } from '../../components/structured-data';
import { langOf, langPaths, localize } from '../../i18n';

export const getStaticPaths = langPaths;

const copy = {
  en: {
    title: 'Mac Cleaner – Get Your Mac’s Space Back, Pay Once | CacheDrop',
    description: 'CacheDrop finds the caches, leftovers and old files filling your Mac, and clears them safely. Made for music producers, developers and video editors.',
    operatingSystem: 'macOS 14 or later',
    // Decision 51's proof: the 18 GB of plug-ins on the owner's Mac, until the Smart clean figure (#105).
    proof: 'CacheDrop found 18 GB of plug-ins on a music producer’s Mac',
    h1: 'Get your Mac’s space back.',
    lede: 'CacheDrop finds the caches, leftovers and old files filling your Mac, and clears them safely. Made for music producers, developers and video editors.',
    download: 'Download for Mac',
    valueEyebrow: 'One app instead of three',
    valueTitle: 'A cleaner, an app uninstaller and a plug-in manager.',
    values: [
      ['See what’s filling your Mac', 'One scan shows caches, old project files, leftovers and big downloads, with their sizes.'],
      ['Remove apps and plug-ins completely', 'Every file they installed goes in one step, and your licenses stay safe.'],
      ['Nothing lost by mistake', 'You check everything first. Your files go to the Trash, and History puts them back.'],
    ],
    workEyebrow: 'Made for your work',
    workTitle: 'Music, code and video fill a Mac fastest.',
    workBody: 'CacheDrop knows where your tools keep their files, so it finds the gigabytes a general cleaner misses.',
    producers: {
      title: 'For music producers',
      body: 'Uninstall VST, AU, AAX and CLAP plug-ins with every file they installed, and clear Ableton Live’s cache. Your licenses stay put.',
      chips: ['VST3 / AU', 'AAX / CLAP', 'Ableton cache'],
      link: 'How to uninstall audio plug-ins',
    },
    developers: {
      title: 'For developers',
      body: 'Clear forgotten <span class="mono" style="font-size: 13px">node_modules</span> folders, Xcode DerivedData and Docker caches safely.',
      chips: ['node_modules', 'DerivedData', 'Docker images'],
      link: 'How to clear developer caches',
    },
    editors: {
      title: 'For video editors',
      body: 'Clear hidden Adobe media caches and size up Final Cut Pro libraries full of render files, without losing your timelines.',
      chips: ['.cfa / .pek', 'Media Cache', 'FCPX Libraries'],
      link: 'How to clear Adobe media cache',
    },
    safeEyebrow: 'Safe by design',
    safeTitle: 'You decide what goes.',
    safeBody: 'CacheDrop shows what it found, where it lives and how much you’ll get back. Then it waits for you.',
    steps: [
      ['You review first', 'Every item shows its size and where it lives before anything moves.'],
      ['Only files apps make again are deleted', 'Caches and build files are deleted, because your apps make them again. Your own files go to the Trash.'],
      ['Put back', 'History lists every cleanup and puts your files back where they were.'],
      ['Your licenses stay safe', 'CacheDrop never touches the license data of your apps and plug-ins.'],
      ['Signed and notarized by Apple', 'Every release is signed and checked by Apple, so macOS opens it without a warning.'],
    ],
    faqTitle: 'Mac storage, answered.',
    faqAsk: 'Still have a question? <a class="textlink" href="#feedback" data-feedback style="color: var(--accent-text)">Ask us directly</a>.',
    // One list feeds both the visible FAQ and the FAQPage JSON-LD, so they can't drift apart.
    faq: [
      ['What is CacheDrop?', 'CacheDrop is a Mac app that finds the caches, leftovers and old files filling your Mac and clears them safely. It also removes apps and audio plug-ins with every file they installed. It’s made for music producers, developers and video editors.'],
      ['How do I free up space on my Mac?', 'Start with the files you can’t see. Caches, build files and app leftovers can take tens of gigabytes, and macOS hides them inside “System Data”. CacheDrop scans for them, shows you what it found and how big each one is, and clears what you approve.'],
      ['What is System Data on a Mac, and can I delete it?', 'System Data is where macOS counts files that don’t fit its other categories, including app caches, logs and developer files. Much of it is safe to remove because apps make those files again. CacheDrop goes after only those parts.'],
      ['Is it safe to delete caches on a Mac?', 'Yes, for caches that apps make again: the app simply creates them the next time it needs them. CacheDrop shows you each one before anything is cleared.'],
      ['How do I completely uninstall an app or plug-in on a Mac?', 'Dragging an app to the Trash leaves its settings, caches and support files behind, and plug-ins install files in several folders. CacheDrop finds every file an app or plug-in installed and removes them in one step, without touching your licenses.'],
      ['How do I clean up my Mac without losing files?', 'Clear caches and build files, not documents. CacheDrop deletes only files apps make again. Your own files go to the Trash, and History puts them back.'],
      ['Is CacheDrop a subscription?', `No. You pay once: a license is ${pricingCopy.en.license}, for up to 3 Macs, with every update through version 1. CleanMyMac is $39.95 every year, for one Mac.`],
      ['How much does CacheDrop cost, and which Macs does it support?', `A license is ${pricingCopy.en.license}, for up to 3 Macs, with 30-day refunds. You can try it before you buy: scanning is always free, and you can clean up to 2 GB first. It’s a universal app for Apple Silicon and Intel Macs on macOS 14 or later.`],
    ],
    closingTitle: 'Try it on your Mac.',
    closingBody: 'One app for Apple Silicon and Intel Macs on macOS 14 or later.',
  },
  fr: {
    title: 'Nettoyer son Mac – Récupérez votre espace, payez une fois | CacheDrop',
    description: 'CacheDrop repère les caches, les restes et les vieux fichiers qui remplissent votre Mac, et les vide en toute sécurité. Fait pour les producteurs de musique, les développeurs et les monteurs vidéo.',
    operatingSystem: 'macOS 14 ou version ultérieure',
    proof: 'CacheDrop a trouvé 18 Go de plug-ins sur le Mac d’un producteur de musique',
    h1: 'Récupérez l’espace de votre Mac.',
    lede: 'CacheDrop repère les caches, les restes et les vieux fichiers qui remplissent votre Mac, et les vide en toute sécurité. Fait pour les producteurs de musique, les développeurs et les monteurs vidéo.',
    download: 'Télécharger pour Mac',
    valueEyebrow: 'Une application au lieu de trois',
    valueTitle: 'Un nettoyeur, un désinstalleur d’applications et un gestionnaire de plug-ins.',
    values: [
      ['Voyez ce qui remplit votre Mac', 'Une seule analyse montre les caches, les vieux fichiers de projets, les restes et les gros téléchargements, avec leur taille.'],
      ['Désinstallez complètement applications et plug-ins', 'Tous les fichiers qu’ils ont installés partent en une seule étape, et vos licences restent intactes.'],
      ['Rien n’est perdu par erreur', 'Vous vérifiez tout avant. Vos fichiers vont dans la Corbeille, et l’historique les remet en place.'],
    ],
    workEyebrow: 'Fait pour votre travail',
    workTitle: 'La musique, le code et la vidéo remplissent un Mac plus vite que tout.',
    workBody: 'CacheDrop sait où vos outils rangent leurs fichiers, et il trouve les gigaoctets qu’un nettoyeur ordinaire laisse passer.',
    producers: {
      title: 'Pour les producteurs de musique',
      body: 'Désinstallez les plug-ins VST, AU, AAX et CLAP avec tous les fichiers qu’ils ont installés, et videz le cache d’Ableton Live. Vos licences restent en place.',
      chips: ['VST3 / AU', 'AAX / CLAP', 'Cache Ableton'],
      link: 'Comment désinstaller des plug-ins audio',
    },
    developers: {
      title: 'Pour les développeurs',
      body: 'Videz en toute sécurité les dossiers <span class="mono" style="font-size: 13px">node_modules</span> oubliés, les DerivedData de Xcode et les caches Docker.',
      chips: ['node_modules', 'DerivedData', 'Images Docker'],
      link: 'Comment vider les caches de développement',
    },
    editors: {
      title: 'Pour les monteurs vidéo',
      body: 'Videz les caches de média Adobe invisibles et mesurez les bibliothèques Final Cut Pro remplies de fichiers de rendu, sans perdre vos montages.',
      chips: ['.cfa / .pek', 'Cache de média', 'Bibliothèques FCPX'],
      link: 'Comment vider le cache de média Adobe',
    },
    safeEyebrow: 'Sûr dès la conception',
    safeTitle: 'Vous décidez de ce qui part.',
    safeBody: 'CacheDrop vous montre ce qu’il a trouvé, où c’est rangé et combien d’espace vous récupérerez. Puis il attend votre feu vert.',
    steps: [
      ['Vous vérifiez d’abord', 'Chaque élément indique sa taille et son emplacement avant que quoi que ce soit ne bouge.'],
      ['Seuls les fichiers que les applications recréent sont supprimés', 'Les caches et les fichiers de compilation sont supprimés, car vos applications les recréent. Vos propres fichiers vont dans la Corbeille.'],
      ['Remettre en place', 'L’historique liste chaque nettoyage et remet vos fichiers là où ils étaient.'],
      ['Vos licences restent intactes', 'CacheDrop ne touche jamais aux données de licence de vos applications et de vos plug-ins.'],
      ['Signé et notarié par Apple', 'Chaque version est signée et vérifiée par Apple, et macOS l’ouvre sans avertissement.'],
    ],
    faqTitle: 'Le stockage du Mac, expliqué.',
    faqAsk: 'Une autre question? <a class="textlink" href="#feedback" data-feedback style="color: var(--accent-text)">Écrivez-nous directement</a>.',
    faq: [
      ['Qu’est-ce que CacheDrop?', 'CacheDrop est une application pour Mac qui repère les caches, les restes et les vieux fichiers qui remplissent votre Mac, et les vide en toute sécurité. Il désinstalle aussi les applications et les plug-ins audio avec tous les fichiers qu’ils ont installés. Il est fait pour les producteurs de musique, les développeurs et les monteurs vidéo.'],
      ['Comment libérer de l’espace sur mon Mac?', 'Commencez par les fichiers que vous ne voyez pas. Les caches, les fichiers de compilation et les restes d’applications peuvent occuper des dizaines de gigaoctets, et macOS les dissimule dans « Données système ». CacheDrop les repère, vous montre ce qu’il a trouvé et la taille de chaque élément, et vide ce que vous approuvez.'],
      ['Que sont les Données système d’un Mac, et puis-je les supprimer?', 'Les Données système regroupent les fichiers que macOS ne classe dans aucune autre catégorie, dont les caches d’applications, les journaux et les fichiers de développement. Une bonne partie peut être supprimée sans risque, car les applications recréent ces fichiers. CacheDrop ne s’attaque qu’à ces parties.'],
      ['Peut-on supprimer les caches d’un Mac sans risque?', 'Oui, pour les caches que les applications recréent : l’application les crée de nouveau la prochaine fois qu’elle en a besoin. CacheDrop vous montre chacun d’eux avant de vider quoi que ce soit.'],
      ['Comment désinstaller complètement une application ou un plug-in sur Mac?', 'Glisser une application dans la Corbeille laisse ses réglages, ses caches et ses fichiers de soutien, et les plug-ins installent des fichiers dans plusieurs dossiers. CacheDrop trouve tous les fichiers qu’une application ou un plug-in a installés et les supprime en une seule étape, sans toucher à vos licences.'],
      ['Comment faire le ménage sur mon Mac sans perdre de fichiers?', 'Videz les caches et les fichiers de compilation, pas vos documents. CacheDrop supprime seulement les fichiers que les applications recréent. Vos propres fichiers vont dans la Corbeille, et l’historique les remet en place.'],
      ['CacheDrop est-il un abonnement?', `Non. Vous payez une seule fois : la licence coûte ${pricingCopy.fr.license}, pour un maximum de 3 Mac, avec toutes les mises à jour de la version 1. CleanMyMac coûte 39,95 $ chaque année, pour un seul Mac.`],
      ['Combien coûte CacheDrop, et sur quels Mac fonctionne-t-il?', `La licence coûte ${pricingCopy.fr.license}, pour un maximum de 3 Mac, avec remboursement dans les 30 jours. Vous pouvez l’essayer avant d’acheter : l’analyse est toujours gratuite, et vous pouvez d’abord nettoyer jusqu’à 2 Go. C’est une application universelle pour les Mac Apple Silicon et Intel sous macOS 14 ou version ultérieure.`],
    ],
    closingTitle: 'Essayez-le sur votre Mac.',
    closingBody: 'Une seule application pour les Mac Apple Silicon et Intel sous macOS 14 ou version ultérieure.',
  },
};
const lang = langOf(Astro.url);
const t = copy[lang];
const download = localize(lang, '/download/');

const site = Astro.site!.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site}/#org`, name: 'CacheDrop', url: `${site}/`, logo: `${site}/assets/cachedrop-app-icon.png` },
    {
      '@type': 'SoftwareApplication',
      name: 'CacheDrop',
      url: `${site}${localize(lang, '/')}`,
      applicationCategory: 'UtilitiesApplication',
      dateModified: lastModified(`${site}${localize(lang, '/')}`),
      operatingSystem: t.operatingSystem,
      processorRequirements: 'Apple Silicon, Intel',
      description: t.description,
      // Decision 51's fact sheet, in the words of the pricing card.
      featureList: pricingCopy[lang].items,
      publisher: { '@id': `${site}/#org` },
      // Decision 47: the price a buyer pays today, with the regular price as the struck-through one
      // while the limited-time offer runs (schema.org StrikethroughPrice).
      offers: {
        '@type': 'Offer',
        price: price.offer,
        priceCurrency: 'USD',
        ...(discounted && {
          priceSpecification: { '@type': 'UnitPriceSpecification', priceType: 'https://schema.org/StrikethroughPrice', price: price.regular, priceCurrency: 'USD' },
        }),
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
    },
  ],
};

const tile = 'width: var(--tile-md); height: var(--tile-md); border-radius: var(--radius-lg); background: var(--surface-subtle); display: flex; align-items: center; justify-content: center; color: var(--ink)';
const chip = 'font-size: 12px; color: var(--ink-body); background: var(--surface-subtle); border-radius: var(--radius-xs); padding: var(--space-1) var(--space-2)';
const chips = 'display: flex; flex-wrap: wrap; gap: var(--space-1-5); padding-top: var(--space-5); border-top: 1px solid var(--line)';
const cardBody = 'margin: var(--space-2) 0 0; font-size: 15px; line-height: 23px; color: var(--ink-soft)';
const cardLink = 'display: inline-flex; align-items: center; gap: var(--space-1-5); font-size: 14px; font-weight: 500; color: var(--accent-text)';
const lede = 'margin: var(--space-4) 0 0; font-size: 17px; line-height: 27px; color: var(--ink-secondary); text-wrap: pretty';
const grid = 'display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: var(--space-6)';
const twoColumns = 'max-width: var(--container-max); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: var(--space-16); align-items: start';
const steps = t.steps.map(([title, body], i) => [`0${i + 1}`, title, body]);

// The value props' icons: a disk with its fill, an app box with an arrow out, a tick in a shield.
const valueIcons = [
  '<rect x="3" y="7" width="18" height="10" rx="3"></rect><path d="M11 12h6"></path><path d="M7 12h.01"></path>',
  '<rect x="4" y="4" width="16" height="16" rx="4"></rect><path d="M12 8v8"></path><path d="M8.5 12.5L12 16l3.5-3.5"></path>',
  '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"></path><path d="M9 12l2 2 4-4"></path>',
];
// The work cards: a waveform, a terminal, a play button.
const work = [
  { id: 'producers', ...t.producers, href: guides.producer.path, icon: '<path d="M4 12h2"></path><path d="M8 8v8"></path><path d="M12 5v14"></path><path d="M16 9v6"></path><path d="M20 11v2"></path>' },
  { id: 'developers', ...t.developers, href: guides.developer.path, icon: '<rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M7 10l3 2-3 2"></path><path d="M13 15h4"></path>' },
  { id: 'editors', ...t.editors, href: guides.creator.path, icon: '<rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M10 9.5v5l4.5-2.5z"></path>' },
];
---
<Base title={t.title} description={t.description} path="/" jsonLd={jsonLd}>
<Nav homeHref="#top" />

<section id="top" style="max-width: var(--container-max); margin: 0 auto; padding: var(--space-28) var(--space-6) var(--space-32); display: flex; flex-direction: column; align-items: center; text-align: center">
<p data-proof style="margin: 0 0 var(--space-8); display: inline-flex; align-items: center; gap: var(--space-2); font-size: 12px; font-weight: 500; color: var(--ink-secondary); padding: var(--space-1-5) var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-full); background: var(--surface-elevated)">
<span aria-hidden="true" style="width: var(--dot); height: var(--dot); border-radius: var(--radius-full); background: var(--success)"></span>
<span>{t.proof}</span>
</p>
<h1 style="margin: 0; font-size: clamp(40px, 6vw, 76px); line-height: 1.04; font-weight: 600; letter-spacing: -0.04em; text-wrap: balance">{t.h1}</h1>
<p style="margin: var(--space-7) 0 0; max-width: var(--lede-max); font-size: 19px; line-height: 29px; font-weight: 400; letter-spacing: -0.012em; color: var(--ink-secondary); text-wrap: pretty">{t.lede}</p>
<div id="download" style="margin-top: var(--space-10); display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-3)">
<a class="btn-primary" href={download} style={primaryLg}>
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
<span>{t.download}</span>
</a>
<BuyButton variant="ghost" />
</div>
<p style="margin: 18px 0 0; font-size: 13px; color: var(--ink-secondary)">{pricingCopy[lang].trial}</p>

<AppWindow />
</section>

<section id="value" style="padding: 0 var(--space-6) var(--space-30)">
<div style="max-width: var(--container-max); margin: 0 auto">
<div style="max-width: var(--lede-max); margin-bottom: var(--space-14)">
<p style={eyebrow}>{t.valueEyebrow}</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.valueTitle}</h2>
</div>
<div style={grid}>
{t.values.map(([title, body], i) => (
<div style="display: flex; flex-direction: column; gap: var(--space-5)">
<div style={tile}>
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={valueIcons[i]} />
</div>
<div>
<h3 style={titleMd}>{title}</h3>
<p style={cardBody}>{body}</p>
</div>
</div>
))}
</div>
</div>
</section>

<section id="work" style="background: var(--surface-subtle); padding: var(--space-30) var(--space-6)">
<div style="max-width: var(--container-max); margin: 0 auto">
<div style="max-width: var(--lede-max); margin-bottom: var(--space-14)">
<p style={eyebrow}>{t.workEyebrow}</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.workTitle}</h2>
<p style={lede}>{t.workBody}</p>
</div>
<div style={grid}>
{work.map((w) => (
<article id={w.id} style={card}>
<div style={tile}>
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={w.icon} />
</div>
<div style="flex: 1">
<h3 style={titleMd}>{w.title}</h3>
<p style={cardBody} set:html={w.body} />
</div>
<div style={chips}>
{w.chips.map((c) => <span class="mono" style={chip}>{c}</span>)}
</div>
<a class="textlink" href={localize(lang, w.href)} style={cardLink}>{w.link}
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
</article>
))}
</div>
</div>
</section>

<section id="safe" style="padding: var(--space-32) var(--space-6)">
<div style={twoColumns}>
<div>
<p style={eyebrow}>{t.safeEyebrow}</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.safeTitle}</h2>
<p style={`${lede}; max-width: 440px`}>{t.safeBody}</p>
</div>
<ol style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column">
{steps.map(([n, title, body], i) => (
<li style={`display: flex; gap: var(--space-6); padding: var(--space-7) 0; border-top: 1px solid var(--line)${i === steps.length - 1 ? '; border-bottom: 1px solid var(--line)' : ''}`}>
<span class="mono" style="flex: none; width: var(--control-xs); font-size: 13px; line-height: 24px; color: var(--ink-secondary)">{n}</span>
<div>
<h3 style={titleMd}>{title}</h3>
<p style="margin: var(--space-1-5) 0 0; font-size: 15px; line-height: 23px; color: var(--ink-soft)">{body}</p>
</div>
</li>
))}
</ol>
</div>
</section>

<PricingSection versus />

<section id="faq" style="padding: 0 var(--space-6) var(--space-32)">
<div style={`${twoColumns}; padding-top: var(--space-28); border-top: 1px solid var(--line)`}>
<div>
<p style={eyebrow}>FAQ</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.faqTitle}</h2>
<p style="margin: var(--space-4) 0 0; max-width: 400px; font-size: 17px; line-height: 27px; color: var(--ink-secondary)" set:html={t.faqAsk} />
</div>
<div style="display: flex; flex-direction: column">
{t.faq.map(([q, a], i) => (
<div style={faqItem(i, t.faq.length)}>
<h3 style={faqQuestion}>{q}</h3>
<p style="margin: var(--space-2) 0 0; font-size: 15px; line-height: 24px; color: var(--ink-soft)">{a}</p>
</div>
))}
</div>
</div>
</section>

<ClosingCta size="home" title={t.closingTitle} body={t.closingBody} href={download} cta={t.download} />

<Footer path="/" />
</Base>
