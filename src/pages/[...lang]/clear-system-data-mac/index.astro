      leaves: [
        'Les instantanés locaux Time Machine : il montre combien il y en a, avec Open Storage Settings. macOS n’en indique pas la taille.',
        'Les sauvegardes d’iPhone et d’iPad, les pièces jointes de Mail et de Messages, et les bibliothèques Photos : leur taille, et l’application qui les gère.',
        'Les caches et journaux système de /Library et /System, qui demanderaient un mot de passe d’administrateur. CacheDrop n’en demande jamais.',
      ],
      p2: 'Avant de nettoyer quoi que ce soit, CacheDrop vérifie de nouveau chaque élément, laisse de côté ce qu’une application ouverte utilise, puis affiche l’espace qu’il a mesuré comme libéré.',
    },
    howTo: 'Comment vider les Données système sur Mac',
  },
};
const lang = langOf(Astro.url);
const t = copy[lang];
const dev = lang === 'fr' ? '/fr/clear-mac-developer-caches/' : '/clear-mac-developer-caches/';
const ids = ['what', 'why', 'safe', 'clear', 'snapshots', 'cachedrop'];
const howTo = { name: t.howTo, steps: t.clear.manual };
---
<Guide {...t.guide} path="/clear-system-data-mac/" dateModified="2026-11-03" howTo={howTo}>
<Toc items={[...ids.map((id, i) => [`#${id}`, t.toc[i]] as [string, string]), ['#faq', t.guide.faqTitle]]} />

<section id="what" style="padding-top: var(--space-16); display: flex; flex-direction: column; gap: var(--space-5)">
<h2 style={guideH2}>{t.toc[0]}</h2>
<p style={`${guideP}; text-wrap: pretty`}>{t.what.p1}</p>
<p style={`${guideP}; text-wrap: pretty`}>{t.what.p2}</p>
</section>

<section id="why" style={section}>
<h2 style={guideH2}>{t.toc[1]}</h2>
<p style={`${guideP}; text-wrap: pretty`}>{t.why.p1}</p>
<ul style={list}>{t.why.items.map((s) => <li set:html={s}></li>)}</ul>
</section>

<section id="safe" style={section}>
<h2 style={guideH2}>{t.toc[2]}</h2>
<p style={`${guideP}; text-wrap: pretty`}>{t.safe.p1}</p>
<table style="width: 100%; border-collapse: collapse; font-size: 14px; line-height: 21px; color: var(--ink-body)">
<thead><tr><th scope="col" style={head}>{t.safe.what}</th><th scope="col" style={head}>{t.safe.todo}</th></tr></thead>
<tbody>
{t.safe.rows.map(([what, where, todo]) => (
<tr><th scope="row" style={`${cell}; font-weight: 600; width: 42%`}><div style="display: flex; flex-direction: column; gap: var(--space-1-5)"><span>{what}</span><span class="ic" style="align-self: flex-start; font-weight: 400; overflow-wrap: anywhere">{where}</span></div></th><td style={cell} set:html={todo.replace('{dev}', dev)}></td></tr>
))}
</tbody>
</table>
</section>

<section id="clear" style={section}>
<h2 style={guideH2}>{t.toc[3]}</h2>
<p style={`${guideP}; text-wrap: pretty`}>{t.clear.p1}</p>
<div style={pair}>
<div style={manual}>
<h3 style={h3}>{t.clear.manualTitle}</h3>
<ol style={list}>{t.clear.manual.map((s) => <li>{s}</li>)}</ol>
</div>
<div style={ours}>
<h3 style={h3}>{t.clear.oursTitle}</h3>
<ol style={list}>{t.clear.ours.map((s) => <li>{s}</li>)}</ol>
</div>
</div>
<Kicker>{t.clear.sizesKicker}</Kicker>
<p style={`${guideP}; text-wrap: pretty`}>{t.clear.sizesP}</p>
<CodeBlock label={t.clear.label} code={sizes} />
</section>

<section id="snapshots" style={section}>
<h2 style={guideH2}>{t.toc[4]}</h2>
<p style={`${guideP}; text-wrap: pretty`}>{t.snapshots.p1}</p>
<p style={`${guideP}; text-wrap: pretty`}>{t.snapshots.listP}</p>
<CodeBlock label={t.snapshots.label} code={listSnapshots} />
<p style={`${guideP}; text-wrap: pretty`} set:html={t.snapshots.listNote}></p>
<div data-warning style={manual}>
<h3 style={h3}>{t.snapshots.warnTitle}</h3>
<ul style={list}>{t.snapshots.warn.map((s) => <li>{s}</li>)}</ul>
</div>
<p style={`${guideP}; text-wrap: pretty`}>{t.snapshots.deleteP}</p>
<CodeBlock label={t.snapshots.label} code={deleteSnapshot} />
</section>

<section id="cachedrop" style={section}>
<h2 style={guideH2}>{t.toc[5]}</h2>
<p style={`${guideP}; text-wrap: pretty`}>{t.cachedrop.p1}</p>
<div style={pair}>
<div style={ours}>
<h3 style={h3}>{t.cachedrop.doesTitle}</h3>
<ul style={list}>{t.cachedrop.does.map((s) => <li>{s}</li>)}</ul>
</div>
<div style={manual}>
<h3 style={h3}>{t.cachedrop.leavesTitle}</h3>
<ul style={list}>{t.cachedrop.leaves.map((s) => <li>{s}</li>)}</ul>
</div>
</div>
<p style={`${guideP}; text-wrap: pretty`}>{t.cachedrop.p2}</p>
</section>
</Guide>
