      system: 'Apps, die für alle Benutzer installiert wurden, können auch Dateien in <span class="ic">/Library</span> hinterlassen, etwa in Application Support, LaunchAgents, LaunchDaemons und PrivilegedHelperTools. Zum Entfernen brauchen Sie ein Administratorpasswort.',
    },
    manual: {
      intro: 'Prüfen Sie jeden der obigen Ordner auf den Namen der App und ihre Bundle-ID. Die Bundle-ID finden Sie heraus, solange die App noch installiert ist:',
      label: 'Terminal',
      title: 'Der manuelle Weg',
      steps: [
        'Beenden Sie die App, auch ein Symbol, das sie in der Menüleiste hält.',
        'Hat die App ein eigenes Deinstallationsprogramm, oder entfernt der Manager ihres Herstellers sie, nutzen Sie zuerst dieses.',
        'Notieren Sie die Bundle-ID (siehe unten) und ziehen Sie die App dann aus „Programme“ in den Papierkorb.',
        'Wählen Sie im Finder Gehe zu › Gehe zum Ordner …, öffnen Sie ~/Library und suchen Sie in jedem der obigen Ordner nach Einträgen, die nach der App oder ihrer Bundle-ID benannt sind.',
        'Legen Sie in den Papierkorb, was zur App gehört. Lassen Sie Ordner stehen, die sich andere Apps desselben Herstellers teilen könnten.',
        'Leeren Sie den Papierkorb erst, wenn Sie sicher sind, dass nichts davon noch gebraucht wird.',
      ],
      p2: 'Terminal kann für Ordner, die macOS schützt, „Operation not permitted“ ausgeben; der Rest der Liste bleibt trotzdem vollständig. Wurde die App über ein Installationspaket installiert, speichert macOS einen Installationsbeleg darüber, was es geschrieben hat:',
      p3: 'Der Abgleich über den Namen ist die häufigste Fehlerquelle beim manuellen Aufräumen. Ein Ordner mit dem Namen des Herstellers kann zu dessen anderen Apps gehören, und ein kurzer Name kann auf eine völlig andere App passen.',
    },
    ours: {
      intro: 'Die Seite „Applications“ in CacheDrop listet jede App in Ihren Ordnern „Programme“ auf, auf jedem Volume, die größte zuerst. Apps von Apple und System-Apps werden nicht aufgeführt. Jede Zeile zeigt den Hersteller der App und ihre Gesamtgröße samt Dateien.',
      steps: [
        'Öffnen Sie Applications und haken Sie eine App an. Die Dateien, die ihre Bundle-ID oder ihr Installationsbeleg ihr zuordnet, werden mit angehakt.',
        'Ordner, die nur so heißen wie die App, erscheinen als Possibly related, mit Begründung, und Sie haken jeden selbst an.',
        'Ist die App geöffnet, bittet CacheDrop Sie, sie zuerst zu beenden. Hat sie ein eigenes Deinstallationsprogramm, steht Open an erster Stelle.',
        'Review zeigt jedes Objekt, bevor etwas verschoben wird. Die App und ihre Dateien kommen in den Papierkorb, und History hält den Vorgang als „Uninstalled“ mit dem Namen der App fest.',
      ],
      never: 'CacheDrop bietet nie Apple-Ordner oder Lizenz- und Aktivierungsdateien an und prüft jedes Objekt kurz vor dem Verschieben noch einmal. Eine App, die macOS nicht ohne Passwort verschieben lässt, trägt „Needs your password to remove“ samt Reveal in Finder: CacheDrop fragt nie nach einem Administratorpasswort.',
      plugins: 'Sie deinstallieren Audio-Plug-ins? Jedes Produkt geht mit allen Formaten und seinen Support-Dateien:',
      pluginsLink: 'Anleitung zum Deinstallieren von Audio-Plug-ins auf dem Mac',
    },
    deleted: {
      p1: 'Apps, die Sie schon in den Papierkorb gezogen haben, haben ihre Dateien noch in Ihrer Library. CacheDrop durchsucht die obigen Ordner nach Objekten, deren App nicht mehr auf diesem Mac ist, auf jedem Volume, und listet sie unter Files from deleted apps auf, nach App gruppiert.',
      p2: 'Ein Objekt wird einer App nur zugeordnet, wenn seine Bundle-ID oder ein Installationsbeleg es dorthin bindet. Ein Ordner, der nur einen Namen mit einer gelöschten App teilt, erscheint als Possibly related, mit Begründung, und Smart clean wählt ihn nie aus. Ordner eines Herstellers, von dem noch eine App oder ein Plug-in auf Ihrem Mac liegt, bleiben erhalten, da diese App sie nutzen kann.',
    },
    putBack: {
      p1: 'Beim Deinstallieren kommt alles in den Papierkorb; nichts wird sofort gelöscht. Nach dem Vorgang hat jedes Objekt in den Ergebnissen und in History einen Link „Put back“, der es an seinen ursprünglichen Platz zurückbringt.',
      p2: 'Der Speicherplatz wird frei, sobald der Papierkorb geleert ist. Empty from Trash in CacheDrop löscht nur, was CacheDrop dorthin verschoben hat, und lässt Ihre eigenen Dateien im Papierkorb unberührt. Ist ein Objekt erst einmal aus dem Papierkorb gelöscht, lässt es sich nicht mehr zurücklegen.',
    },
    howTo: 'So deinstallieren Sie eine App auf dem Mac komplett',
  },
};
// Uninstalls count toward the 2 GB (Trial.swift, mac-cleaner Decision 135), so the FAQ's last answer never says
// uninstalling is free.
const lang = langOf(Astro.url);
const t = copy[lang];
const ids = ['why', 'where', 'manual', 'cachedrop', 'deleted-apps', 'put-back'];
const howTo = { name: t.howTo, steps: t.manual.steps };
---
<Guide {...t.guide} path="/uninstall-apps-mac/" dateModified="2026-11-03" howTo={howTo}>
<Toc items={[...ids.map((id, i) => [`#${id}`, t.toc[i]] as [string, string]), ['#faq', t.guide.faqTitle]]} />

<section id="why" style="padding-top: var(--space-16); display: flex; flex-direction: column; gap: var(--space-5)">
<h2 style={guideH2}>{t.toc[0]}</h2>
<p style={`${guideP}; text-wrap: pretty`}>{t.why.p1}</p>
<p style={`${guideP}; text-wrap: pretty`}>{t.why.p2}</p>
</section>

<section id="where" style={section}>
<h2 style={guideH2}>{t.toc[1]}</h2>
<p style={`${guideP}; text-wrap: pretty`} set:html={t.where.intro}></p>
<table style="width: 100%; border-collapse: collapse; font-size: 14px; line-height: 21px; color: var(--ink-body)">
<thead><tr><th scope="col" style={head}>{t.where.folder}</th><th scope="col" style={head}>{t.where.holds}</th></tr></thead>
<tbody>
{folders.map((folder, i) => (
<tr><th scope="row" style={`${cell}; font-weight: 400`}><span class="ic" style="overflow-wrap: anywhere">~/Library/{folder}</span></th><td style={cell}>{t.where.rows[i]}</td></tr>
))}
</tbody>
</table>
<p style={`${guideP}; text-wrap: pretty`} set:html={t.where.system}></p>
</section>

<section id="manual" style={section}>
<h2 style={guideH2}>{t.toc[2]}</h2>
<div style={manual}>
<h3 style={h3}>{t.manual.title}</h3>
<ol style={list}>{t.manual.steps.map((s) => <li>{s}</li>)}</ol>
</div>
<p style={`${guideP}; text-wrap: pretty`}>{t.manual.intro}</p>
<CodeBlock label={t.manual.label} code={'osascript -e \'id of app "AppName"\'\nfind ~/Library -maxdepth 2 -iname \'*com.maker.appname*\''} />
<p style={`${guideP}; text-wrap: pretty`}>{t.manual.p2}</p>
<CodeBlock label={t.manual.label} code={'pkgutil --pkgs | grep -i maker\npkgutil --files com.maker.pkg.AppName'} />
<p style={`${guideP}; text-wrap: pretty`}>{t.manual.p3}</p>
</section>

<section id="cachedrop" style={section}>
<h2 style={guideH2}>{t.toc[3]}</h2>
<p style={`${guideP}; text-wrap: pretty`}>{t.ours.intro}</p>
<div style={ours}>
<ol style={list}>{t.ours.steps.map((s) => <li>{s}</li>)}</ol>
</div>
<p style={`${guideP}; text-wrap: pretty`}>{t.ours.never}</p>
<p style={`${guideP}; text-wrap: pretty`}>{t.ours.plugins} <a class="textlink" href={localize(lang, '/uninstall-audio-plugins-mac/')} style={link}>{t.ours.pluginsLink}</a>.</p>
</section>

<section id="deleted-apps" style={section}>
<h2 style={guideH2}>{t.toc[4]}</h2>
<p style={`${guideP}; text-wrap: pretty`}>{t.deleted.p1}</p>
<p style={`${guideP}; text-wrap: pretty`}>{t.deleted.p2}</p>
</section>

<section id="put-back" style={section}>
<h2 style={guideH2}>{t.toc[5]}</h2>
<p style={`${guideP}; text-wrap: pretty`}>{t.putBack.p1}</p>
<p style={`${guideP}; text-wrap: pretty`}>{t.putBack.p2}</p>
</section>
</Guide>
