// legal advice. Say only what the decisions say. Built at /terms-of-sale/ and /fr/terms-of-sale/.
import Legal from '../../../layouts/Legal.astro';
import { HELLO, link, mail, type LegalSection } from '../../../components/legal';
import { langOf, langPaths, localize } from '../../../i18n';

export const getStaticPaths = langPaths;

const path = '/terms-of-sale/';
const lang = langOf(Astro.url);
const to = (english: string, text: string) => link(localize(lang, english), text);
const MAIL = mail(HELLO);

