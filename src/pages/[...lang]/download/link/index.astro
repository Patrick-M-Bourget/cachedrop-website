---
// The token page (Decision 2): "Your download has started" from handoff/site/download/. Vercel
// rewrites the emailed /download/<token>/ to this page (vercel.json). The script reads the token
// from the address, shows the latest release's filename, and starts the download through
// /api/download, which counts the start and redirects to a 60-second signed URL. The retry link
// goes through the same endpoint, so it always gets a fresh URL.
// Opened at its own path there is no token, so the script does nothing and the page renders as
// the handoff does (tests/pages.ts compares it).
// Built at /download/link/ and /fr/download/link/ (Decision 5); French emails link to
// /fr/download/<token>/, and an expired French link goes to the French form.
import Base from '../../../../layouts/Base.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import { downloadHead, downloadMeta, guideLinks } from '../_head.ts';
import { titleMd } from '../../../../components/guide-styles';
import { langOf, langPaths, localize } from '../../../../i18n';

export const getStaticPaths = langPaths;

const copy = {
  en: {
    title: 'Your download has started.',
    lede: 'Thanks for trying the CacheDrop beta. It takes about a minute to set up.',
    retry: 'Download didn’t start? Try again',
    steps: [
      ['Open the disk image', 'Double-click <span class="mono" style="font-size: 13px" data-filename>CacheDrop.dmg</span> in your Downloads folder.'],
      ['Drag it to Applications', 'Drop the CacheDrop icon onto the Applications folder, then eject the disk image.'],
      ['Choose what to scan', 'Open CacheDrop, pick the folders it can look in under Locations &amp; access, and run your first scan.'],
    ],
    help: 'Help us build it',
    helpBody: 'CacheDrop is free while in beta. If a scan misses something or a result surprises you, tell us. It takes thirty seconds.',
    feedback: 'Give Fast Feedback',
    installing: 'While it installs:',
  },
  fr: {
    title: 'Votre téléchargement a commencé.',
    lede: 'Merci d’essayer la bêta de CacheDrop. L’installation prend environ une minute.',
    retry: 'Le téléchargement n’a pas commencé? Réessayez',
    steps: [
      ['Ouvrez l’image disque', 'Double-cliquez sur <span class="mono" style="font-size: 13px" data-filename>CacheDrop.dmg</span> dans votre dossier Téléchargements.'],
      ['Glissez CacheDrop dans Applications', 'Déposez l’icône de CacheDrop sur le dossier Applications, puis éjectez l’image disque.'],
      ['Choisissez quoi analyser', 'Ouvrez CacheDrop, choisissez les dossiers où il peut chercher, sous Locations &amp; access, et lancez votre première analyse.'],
    ],
    help: 'Aidez-nous à le bâtir',
    helpBody: 'CacheDrop est gratuit pendant la bêta. Si une analyse oublie quelque chose ou qu’un résultat vous surprend, dites-le-nous. Ça prend trente secondes.',
    feedback: 'Donner votre avis',
    installing: 'Pendant l’installation :',
  },
};
const lang = langOf(Astro.url);
const t = copy[lang];
const meta = downloadMeta[lang];
const expiredForm = `${localize(lang, '/download/')}?link=expired`;

const card = 'padding: var(--space-8); border: 1px solid var(--line); border-radius: var(--radius-2xl); background: var(--surface); box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: var(--space-3)';
const stepN = 'font-size: 13px; color: var(--ink-secondary)';
const stepBody = 'margin: 0; font-size: 15px; line-height: 23px; color: var(--ink-soft)';
const guideLink = 'color: var(--accent-text); font-weight: 500';
---
<Base {...downloadHead[lang]}>
<Nav />

<main style="padding: 104px var(--space-6) var(--space-32)">
<div style="max-width: var(--window-max); margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center">
<div style="width: var(--tile-lg); height: var(--tile-lg); border-radius: var(--radius-2xl); background: var(--surface-subtle); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--ink)">
<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
</div>
<h1 style="margin: var(--space-8) 0 0; font-size: clamp(34px, 4.6vw, 56px); line-height: 1.08; font-weight: 600; letter-spacing: -0.035em; text-wrap: balance">{t.title}</h1>
<p style="margin: 18px 0 0; max-width: 560px; font-size: 19px; line-height: 29px; color: var(--ink-secondary); text-wrap: pretty">{t.lede}</p>
<p style="margin: var(--space-5) 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2) var(--space-4); font-size: 13px; color: var(--ink-secondary)">
<span class="mono" data-filename>CacheDrop.dmg</span>
<span aria-hidden="true">·</span>
<span>{meta[1]}</span>
<span aria-hidden="true">·</span>
<span>{meta[2]}</span>
</p>
<a class="textlink" href={localize(lang, '/download/')} data-dmg style="margin-top: var(--space-4); font-size: 14px; font-weight: 500; color: var(--accent-text)">{t.retry}</a>

<ol style="margin: var(--space-18) 0 0; padding: 0; list-style: none; width: 100%; text-align: left; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: var(--space-6)">
{t.steps.map(([title, body], i) => (
<li style={card}>
<span class="mono" style={stepN}>{`0${i + 1}`}</span>
<h2 style={titleMd}>{title}</h2>
<p style={stepBody} set:html={body}></p>
</li>
))}
</ol>

<div style="margin-top: var(--space-8); width: 100%; padding: var(--space-8); border-radius: var(--radius-2xl); background: var(--surface-subtle); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-5); text-align: left">
<div style="max-width: 560px">
<h2 style={titleMd}>{t.help}</h2>
<p style="margin: var(--space-1-5) 0 0; font-size: 15px; line-height: 23px; color: var(--ink-soft)">{t.helpBody}</p>
</div>
<a class="btn-ghost" href="#feedback" data-feedback style="display: inline-flex; align-items: center; height: var(--tap-min); padding: 0 var(--space-5); border-radius: var(--radius-full); border: 1px solid var(--line-strong); background: var(--surface); font-size: 15px; font-weight: 500">{t.feedback}</a>
</div>

<div style="margin-top: var(--space-18); display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3) var(--space-8); font-size: 14px">
<span style="color: var(--ink-secondary)">{t.installing}</span>
<a class="textlink" href={localize(lang, '/clear-mac-developer-caches/')} style={guideLink}>{guideLinks[lang][0]}</a>
<a class="textlink" href={localize(lang, '/clear-adobe-media-cache-mac/')} style={guideLink}>{guideLinks[lang][1]}</a>
</div>
</div>
</main>

<Footer path="/download/" overview />

<script is:inline define:vars={{ expiredForm }}>
(function () {
  var match = location.pathname.match(/^(?:\/fr)?\/download\/([A-Za-z0-9_-]{43})\/?$/);
  if (!match) return;
  var token = match[1];
  var start = '/api/download?token=' + token;
  document.querySelector('[data-dmg]').href = start;
  fetch('/api/release?token=' + token)
    .then(function (res) {
      // An unknown or expired link shows "This link has expired" with the form for a new one.
      // replace() keeps the dead token out of the history.
      if (res.status === 404 || res.status === 410) return location.replace(expiredForm);
      if (!res.ok) return;
      return res.json().then(function (release) {
        document.querySelectorAll('[data-filename]').forEach(function (el) { el.textContent = release.filename; });
        setTimeout(function () { location.href = start; }, 400);
      });
    })
    .catch(function () {});
})();
</script>
</Base>
