---
// The email gate (Decision 1): every Download button lands here. The signup card is SignupForm,
// shared with landing pages that take the signup on the page (Decision 48); it posts to
// /api/signup and then says to check the inbox. /download/?link=expired is the expired-link state:
// the same form under "This link has expired." Built from the design system's utility-page recipe,
// with the token page's head, at /download/ and /fr/download/ (Decision 5).
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import SignupForm from '../../../components/SignupForm.astro';
import { buyHref } from '../../../components/pricing';
import { downloadHead, downloadMeta, guideLinks } from './_head.ts';
import { langOf, langPaths, localize } from '../../../i18n';

export const getStaticPaths = langPaths;

const copy = {
  en: {
    title: 'Download CacheDrop for Mac.',
    lede: 'We’ll email your download link and let you know when updates are ready.',
    expiredTitle: 'This link has expired.',
    expiredLede: 'Download links work for 7 days. Enter your email and we’ll send you a new one. CacheDrop itself doesn’t expire.',
    wait: 'While you wait:',
    producer: 'Uninstall Audio Plug-ins guide',
    tried: 'Already tried it?',
    buy: 'Buy a license',
  },
  fr: {
    title: 'Téléchargez CacheDrop pour Mac.',
    lede: 'Nous vous enverrons votre lien de téléchargement par courriel et vous dirons quand des mises à jour seront prêtes.',
    expiredTitle: 'Ce lien a expiré.',
    expiredLede: 'Les liens de téléchargement fonctionnent pendant 7 jours. Entrez votre adresse courriel et nous vous en enverrons un nouveau. CacheDrop lui-même n’expire pas.',
    wait: 'En attendant :',
    producer: 'Guide pour désinstaller des plug-ins audio',
    tried: 'Vous l’avez déjà essayé?',
    buy: 'Achetez une licence',
  },
};
const lang = langOf(Astro.url);
const t = copy[lang];
const meta = downloadMeta[lang];
const expired = { title: t.expiredTitle, lede: t.expiredLede };
const guideLink = 'color: var(--accent-text); font-weight: 500';
---
<Base {...downloadHead[lang]}>
<Nav />

<main style="padding: 104px var(--space-6) var(--space-32)">
<div style="max-width: var(--window-max); margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center">
<div style="width: var(--tile-lg); height: var(--tile-lg); border-radius: var(--radius-2xl); background: var(--surface-subtle); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--ink)">
<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
</div>
<h1 data-gate-title style="margin: var(--space-8) 0 0; font-size: clamp(34px, 4.6vw, 56px); line-height: 1.08; font-weight: 600; letter-spacing: -0.035em; text-wrap: balance">{t.title}</h1>
<p data-gate-lede style="margin: 18px 0 0; max-width: 560px; font-size: 19px; line-height: 29px; color: var(--ink-secondary); text-wrap: pretty">{t.lede}</p>
<script is:inline define:vars={{ expired }}>
// The token page sends an expired or unknown link here (Decision 2). Swapped before first paint.
if (new URLSearchParams(location.search).get('link') === 'expired') {
  document.querySelector('[data-gate-title]').textContent = expired.title;
  document.querySelector('[data-gate-lede]').textContent = expired.lede;
}
</script>
<p style="margin: var(--space-5) 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2) var(--space-4); font-size: 13px; color: var(--ink-secondary)">
<span>{meta[0]}</span>
<span aria-hidden="true">·</span>
<span>{meta[1]}</span>
</p>

<SignupForm lang={lang} style="margin-top: var(--space-12)" />

<p data-buy style="margin: var(--space-8) 0 0; font-size: 14px; color: var(--ink-secondary)">{t.tried} <a class="textlink" href={buyHref(lang)} style={guideLink}>{t.buy}</a></p>

<div style="margin-top: var(--space-18); display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3) var(--space-8); font-size: 14px">
<span style="color: var(--ink-secondary)">{t.wait}</span>
<a class="textlink" href={localize(lang, '/clear-mac-developer-caches/')} style={guideLink}>{guideLinks[lang][0]}</a>
<a class="textlink" href={localize(lang, '/clear-adobe-media-cache-mac/')} style={guideLink}>{guideLinks[lang][1]}</a>
<a class="textlink" href={localize(lang, '/uninstall-audio-plugins-mac/')} style={guideLink}>{t.producer}</a>
<a class="textlink" href={localize(lang, '/clear-system-data-mac/')} style={guideLink}>{guideLinks[lang][2]}</a>
</div>
</div>
</main>

<Footer path="/download/" overview />
</Base>
