---
// DRAFT for #87 (needs grilling): the compare page. English only, noindex and out of the sitemap
// until the grill settles the claims, the competitors and the French copy. Built from the
// homepage's parts (hero, section header, ruled rows, feature cards, FAQ, closing CTA) and tokens.
// After the grill, the rows move to src/components/compare.ts with a source and checkedOn each.
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import ClosingCta from '../../../components/ClosingCta.astro';
import { card, eyebrow, faqItem, faqQuestion, primaryLg, secondaryLg, sectionH2, titleMd } from '../../../components/guide-styles';
import { pricingCopy } from '../../../components/pricing';

export const getStaticPaths = () => [{ params: { lang: undefined } }];

const price = pricingCopy.en.was; // the regular price, $29.99 (owner, 2026-11-02); the discount is temporary
const launchPrice = pricingCopy.en.now;
const checkedOn = 'November 2026';

const t = {
  title: 'CleanMyMac Alternative With No Subscription – CacheDrop',
  description: `Looking for a CleanMyMac alternative? CacheDrop is a Mac storage cleaner you pay for once: ${price}, up to 3 Macs, no subscription. Scanning is free, and you can clean 2 GB before you buy.`,
  badge: 'CleanMyMac alternative · No subscription',
  h1: 'The Mac cleaner<br>that only cleans.',
  lede: `CacheDrop is a Mac storage cleaner that does one job: it finds the caches, build files and leftovers filling your disk, and clears what you approve. ${price} once, for up to 3 Macs. Not every year.`,
  download: 'Download Free',
  seePricing: 'Compare Prices',
  meta: 'Scanning is always free · Clean 2 GB before you buy · 30-day refunds',

  priceEyebrow: 'Pricing compared',
  priceTitle: 'Pay once. Not every year.',
  priceBody: 'Most Mac cleaners are subscriptions that renew on their own. CacheDrop is a license you buy once and keep, for every 1.x release.',
  priceNote: `Prices are each company’s list price for one license in US dollars, before tax, checked ${checkedOn}. CleanMyMac also sells a one-time license for about $119.95 that covers its current major version. Over three years means three yearly renewals.`,
  launchNote: `Limited-time price: ${launchPrice} right now.`,

  leaveEyebrow: 'Left out on purpose',
  leaveTitle: 'No RAM booster. No antivirus. Just your disk.',
  leaveBody: 'Many Mac cleaners grow into suites: memory “boosters”, malware scanners, app updaters, system monitors, newsletters. Most of that is work macOS already does. CacheDrop leaves it out, so the app stays small, quiet and focused on space.',
  leave: [
    ['RAM cleaners', 'macOS manages memory on its own. Clearing it makes your apps reload what they just had, which is slower, not faster.'],
    ['“Repair permissions”', 'macOS has protected its own system files since OS X El Capitan. There is nothing left for a cleaner to repair.'],
    ['Malware scanners', 'XProtect is built into macOS and updates itself in the background.'],
    ['App updaters and system monitors', 'The App Store, each app’s own updater and Activity Monitor already do this.'],
    ['Announcements in the app', 'No newsletters, no upsells inside the app. You hear from CacheDrop when an update is ready.'],
  ],

  doesEyebrow: 'What you get',
  doesTitle: 'Every feature frees space or shows where it went.',
  does: [
    ['Smart Clean', 'One click clears the caches and build files apps rebuild on their own, after you see what’s in them.'],
    ['Developer and Creator Caches', 'Xcode DerivedData, node_modules, Docker, Adobe media cache and Final Cut Pro render files.'],
    ['Uninstall Apps Completely', 'Moves an app and the leftovers it scattered across your Library to the Trash.'],
    ['Storage Trends', 'See which folders grew since your last scan, so you know where the space keeps going.'],
    ['History', 'Every cleanup is recorded: what went, how big it was, and whether it’s still in the Trash.'],
    ['Free Space in the Menu Bar', 'Free space at a glance, a weekly reminder if you want one, and Empty Trash with a list first.'],
  ],

  pickEyebrow: 'Choose the right tool',
  pickTitle: 'Honest about the alternatives.',
  pick: [
    ['Only want a map of your disk?', 'DaisyDisk is $9.99 and draws a beautiful one.'],
    ['Only removing one app?', 'AppCleaner is free and does exactly that.'],
    ['Want an all-in-one suite with monitors and an updater?', 'CleanMyMac is the full package, on a yearly plan.'],
    ['Want your disk space back, with a look before anything moves?', 'That’s CacheDrop.'],
  ],

  faqTitle: 'Switching, answered.',
  faq: [
    ['Is CacheDrop a good CleanMyMac alternative?', `Yes, if what you need is disk space. CacheDrop finds caches, build files and app leftovers, shows you each one, and clears what you approve. It costs ${price} once instead of a yearly plan. It has no malware scanner, RAM cleaner or system monitor.`],
    ['Is CacheDrop a subscription?', `No. A license is ${price}, paid once, for up to 3 of your Macs and every 1.x release. Nothing renews.`],
    ['Can I try CacheDrop for free?', 'Yes. Scanning is always free, and you can clean up to 2 GB before you buy. If you buy and change your mind, refunds are no questions asked for 30 days.'],
    ['Do I need a RAM cleaner on a Mac?', 'No. macOS manages memory itself and keeps recently used data in memory on purpose. Clearing it makes apps slower to switch back to.'],
    ['What happens to the files CacheDrop cleans?', 'Caches that apps rebuild are deleted. Your own files go to the Trash, so changing your mind is one drag away.'],
    ['Which Macs does CacheDrop support?', 'It’s a universal app for Apple Silicon and Intel Macs running macOS 14 Sonoma or later.'],
  ],

  closingTitle: 'See what it finds on your Mac.',
  closingBody: 'Scanning is free. Look at what CacheDrop finds before you pay anything.',
};

// Columns lead with the price and the three-year cost, so a phone shows them before the table scrolls.
const rows = [
  { name: 'CacheDrop', price: price, billing: 'One-time', macs: 'Up to 3', three: price, renews: 'No', us: true },
  { name: 'CleanMyMac', price: '$39.95/yr', billing: 'Yearly or monthly', macs: '1', three: '$119.85', renews: 'Yes', us: false },
  { name: 'MacCleaner Pro', price: '$39.95/yr', billing: 'Yearly', macs: '1', three: '$119.85', renews: 'Yes', us: false },
];
const cols = ['Price', 'Over 3 years', 'Macs', 'Renews on its own', 'Billing'];

const site = Astro.site!.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'CacheDrop', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Compare', item: `${site}/compare/` },
    ] },
    { '@type': 'FAQPage', mainEntity: t.faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
  ],
};

const lede = 'margin: var(--space-4) 0 0; font-size: 17px; line-height: 27px; color: var(--ink-secondary); text-wrap: pretty';
const rowBody = 'margin: var(--space-1-5) 0 0; font-size: 15px; line-height: 23px; color: var(--ink-soft)';
const th = 'text-align: left; padding: var(--space-3) var(--space-4); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-secondary); border-bottom: 1px solid var(--line); white-space: nowrap';
const td = 'padding: var(--space-4); font-size: 15px; line-height: 23px; color: var(--ink-soft); border-bottom: 1px solid var(--line); white-space: nowrap';
const check = '<svg style="flex: none; margin-top: var(--space-0-5); color: var(--success-ink)" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>';
const dash = '<svg style="flex: none; margin-top: var(--space-0-5); color: var(--ink-secondary)" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 12h12"></path></svg>';
---
<Base title={t.title} description={t.description} path="/compare/" robots="noindex, follow" jsonLd={jsonLd}>
<Nav />
<main>

<section style="max-width: var(--container-max); margin: 0 auto; padding: var(--space-28) var(--space-6) var(--space-30); display: flex; flex-direction: column; align-items: center; text-align: center">
<p style="margin: 0 0 var(--space-8); display: inline-flex; align-items: center; gap: var(--space-2); font-size: 12px; font-weight: 500; color: var(--ink-secondary); padding: var(--space-1-5) var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-full); background: var(--surface-elevated)">
<span aria-hidden="true" style="width: var(--dot); height: var(--dot); border-radius: var(--radius-full); background: var(--success)"></span>
<span>{t.badge}</span>
</p>
<h1 style="margin: 0; font-size: clamp(40px, 6vw, 76px); line-height: 1.04; font-weight: 600; letter-spacing: -0.04em; text-wrap: balance" set:html={t.h1} />
<h2 style="margin: var(--space-7) 0 0; max-width: var(--lede-max); font-size: 19px; line-height: 29px; font-weight: 400; letter-spacing: -0.012em; color: var(--ink-secondary); text-wrap: pretty">{t.lede}</h2>
<div style="margin-top: var(--space-10); display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-3)">
<a class="btn-primary" href="/download/" style={primaryLg}>
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
<span>{t.download}</span>
</a>
<a class="btn-ghost" href="#prices" style={secondaryLg}>{t.seePricing}</a>
</div>
<p style="margin: 18px 0 0; font-size: 13px; color: var(--ink-secondary)">{t.meta}</p>
</section>

<section id="prices" aria-labelledby="prices-title" style="background: var(--surface-subtle); padding: var(--space-30) var(--space-6)">
<div style="max-width: var(--container-max); margin: 0 auto">
<div style="max-width: var(--lede-max); margin-bottom: var(--space-14)">
<p style={eyebrow}>{t.priceEyebrow}</p>
<h2 id="prices-title" style={sectionH2}>{t.priceTitle}</h2>
<p style={lede}>{t.priceBody}</p>
</div>
<div style={`${card}; padding: var(--space-2) var(--space-4); gap: 0; overflow-x: auto`}>
<table style="width: 100%; border-collapse: collapse">
<caption class="sr-only">Mac cleaner prices compared</caption>
<thead><tr><th scope="col" style={th}><span class="sr-only">App</span></th>{cols.map((c) => <th scope="col" style={th}>{c}</th>)}</tr></thead>
<tbody>
{rows.map((r, i) => (
<tr style={r.us ? 'background: var(--accent-soft)' : ''}>
<th scope="row" style={`${td}; text-align: left; font-weight: 600; color: var(--ink)${i === rows.length - 1 ? '; border-bottom: 0' : ''}`}>{r.name}</th>
{[r.price, r.three, r.macs, r.renews, r.billing].map((v) => <td style={`${td}${r.us ? '; color: var(--ink); font-weight: 500' : ''}${i === rows.length - 1 ? '; border-bottom: 0' : ''}`}>{v}</td>)}
</tr>
))}
</tbody>
</table>
</div>
<div style="margin-top: var(--space-6); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4)">
<p style="margin: 0; max-width: var(--reading-max); font-size: 13px; line-height: 19px; color: var(--ink-secondary)">{t.priceNote}</p>
<p style="margin: 0; font-size: 13px; line-height: 19px; font-weight: 500; color: var(--success-ink); background: var(--success-soft); border-radius: var(--radius-full); padding: var(--space-1-5) var(--space-3)">{t.launchNote}</p>
</div>
</div>
</section>

<section style="padding: var(--space-32) var(--space-6)">
<div style="max-width: var(--container-max); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: var(--space-16); align-items: start">
<div>
<p style={eyebrow}>{t.leaveEyebrow}</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.leaveTitle}</h2>
<p style={`${lede}; max-width: 440px`}>{t.leaveBody}</p>
</div>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column">
{t.leave.map(([title, body], i) => (
<li style={`display: flex; gap: var(--space-4); padding: var(--space-6) 0; border-top: 1px solid var(--line)${i === t.leave.length - 1 ? '; border-bottom: 1px solid var(--line)' : ''}`}>
<Fragment set:html={dash} />
<div>
<h3 style={titleMd}>{title}</h3>
<p style={rowBody}>{body}</p>
</div>
</li>
))}
</ul>
</div>
</section>

<section style="background: var(--surface-subtle); padding: var(--space-30) var(--space-6)">
<div style="max-width: var(--container-max); margin: 0 auto">
<div style="max-width: var(--lede-max); margin-bottom: var(--space-14)">
<p style={eyebrow}>{t.doesEyebrow}</p>
<h2 style={sectionH2}>{t.doesTitle}</h2>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: var(--space-6)">
{t.does.map(([title, body]) => (
<article style={`${card}; flex-direction: row; gap: var(--space-4)`}>
<Fragment set:html={check} />
<div>
<h3 style={titleMd}>{title}</h3>
<p style={rowBody}>{body}</p>
</div>
</article>
))}
</div>
</div>
</section>

<section style="padding: var(--space-32) var(--space-6) 0">
<div style="max-width: var(--container-max); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: var(--space-16); align-items: start">
<div>
<p style={eyebrow}>{t.pickEyebrow}</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.pickTitle}</h2>
</div>
<dl style="margin: 0; display: flex; flex-direction: column">
{t.pick.map(([q, a], i) => (
<div style={`padding: var(--space-6) 0; border-top: 1px solid var(--line)${i === t.pick.length - 1 ? '; border-bottom: 1px solid var(--line)' : ''}`}>
<dt style={titleMd}>{q}</dt>
<dd style={`${rowBody}; margin-left: 0${i === t.pick.length - 1 ? '; color: var(--ink); font-weight: 500' : ''}`}>{a}</dd>
</div>
))}
</dl>
</div>
</section>

<section id="faq" style="padding: 0 var(--space-6) var(--space-32)">
<div style="max-width: var(--container-max); margin: var(--space-28) auto 0; padding-top: var(--space-28); border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: var(--space-16); align-items: start">
<div>
<p style={eyebrow}>FAQ</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>{t.faqTitle}</h2>
</div>
<div style="display: flex; flex-direction: column">
{t.faq.map(([q, a], i) => (
<div style={faqItem(i, t.faq.length)}>
<h3 style={faqQuestion}>{q}</h3>
<p style="margin: var(--space-2) 0 0; font-size: 15px; line-height: 24px; color: var(--ink-soft)">{a}</p>
</div>
))}
</div>
</div>
</section>

<ClosingCta size="home" title={t.closingTitle} body={t.closingBody} href="/download/" cta={t.download} />
</main>
<Footer path="/compare/" />
</Base>
