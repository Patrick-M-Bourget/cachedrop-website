---
// Privacy policy (Decisions 16, 19, 21, 29), in the guide-page layout from
// handoff/site/clear-mac-developer-caches/. English only; French comes with /fr/ (Decision 5).
// A lawyer reviews this text before launch (Decision 22). Say only what the decisions say.
// It describes the launch state, e.g. feedback in a private repository (Decision 30).
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const path = '/privacy/';
const description =
  'What the CacheDrop website collects, why, who handles it, how long it is kept, and how to see, correct or delete your information.';

const site = Astro.site!.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'CacheDrop', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Privacy policy', item: `${site}${path}` },
  ],
};

const toc = [
  ['responsible', 'Who is responsible'],
  ['collect', 'What we collect and why'],
  ['providers', 'Who handles your information'],
  ['retention', 'How long we keep it'],
  ['rights', 'Your rights'],
  ['contact', 'Contact us'],
];

const h2 = 'margin: 0; font-size: clamp(26px, 3vw, 34px); line-height: 1.2; font-weight: 600; letter-spacing: -0.025em';
const body = 'margin: var(--space-4) 0 0; font-size: 17px; line-height: 28px; color: var(--ink-body); text-wrap: pretty';
const list = 'margin: var(--space-4) 0 0; padding: 0 0 0 var(--space-5); display: flex; flex-direction: column; gap: var(--space-2-5); font-size: 17px; line-height: 28px; color: var(--ink-body)';
const section = 'padding-top: var(--space-18)';
const lead = 'font-weight: 600; color: var(--ink)';
const mail = 'color: var(--accent-text); font-weight: 500';
---
<Base title="Privacy Policy | CacheDrop" description={description} path={path} jsonLd={jsonLd}>
<style is:global>
.toc a{color:var(--ink-body)}
.toc a:hover{color:var(--accent-text)}
</style>
<Nav current={path} />

<main>
<section style="background: var(--surface-elevated); border-bottom: 1px solid var(--line); padding: var(--space-18) var(--space-6) var(--space-22)">
<div style="max-width: var(--reading-max); margin: 0 auto">
<nav aria-label="Breadcrumb">
<ol style="margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-size: 13px; color: var(--ink-secondary)">
<li><a class="flink" href="/">CacheDrop</a></li>
<li aria-hidden="true" style="display: flex"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg></li>
<li aria-current="page" style="color: var(--ink-body)">Privacy policy</li>
</ol>
</nav>
<h1 style="margin: var(--space-10) 0 0; font-size: clamp(38px, 5.4vw, 64px); line-height: 1.06; font-weight: 600; letter-spacing: -0.04em; text-wrap: balance">Privacy policy</h1>
<p style="margin: var(--space-6) 0 0; font-size: 19px; line-height: 29px; font-weight: 400; letter-spacing: -0.012em; color: var(--ink-secondary); text-wrap: pretty">What this website collects, why, who handles it, and how long we keep it. In plain words.</p>
<p style="margin: var(--space-10) 0 0; font-size: 13px; color: var(--ink-secondary)">Updated October 2026</p>
</div>
</section>

<div style="max-width: var(--reading-max); margin: 0 auto; padding: var(--space-18) var(--space-6) var(--space-30)">

<nav class="toc" aria-label="On this page" style="padding: var(--space-6) var(--space-7); border: 1px solid var(--line); border-radius: var(--radius-2xl)">
<p style="margin: 0 0 var(--space-3); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-secondary)">On this page</p>
<ol style="margin: 0; padding: 0 0 0 var(--space-5); display: flex; flex-direction: column; gap: var(--space-2); font-size: 15px; line-height: 22px">
{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
</ol>
</nav>

<section id="responsible" style="padding-top: var(--space-16)">
<h2 style={h2}>Who is responsible</h2>
<p style={body}>This policy covers the CacheDrop website, cachedrop.io, and the emails it sends.</p>
<p style={body}>CacheDrop’s owner is the person in charge of the protection of personal information. For any question about your information, write to <a class="textlink" href="mailto:privacy@cachedrop.io" style={mail}>privacy@cachedrop.io</a>.</p>
</section>

<section id="collect" style={section}>
<h2 style={h2}>What we collect and why</h2>
<p style={body}>We only collect what you give us, plus a count of page visits.</p>
<ul style={list}>
<li><span style={lead}>Your email address</span>, when you ask for the download. We send your download link to it. We also email you when a new version is out, and about security problems. These emails never promote anything.</li>
<li><span style={lead}>What’s filling your Mac</span>, if you pick an answer: Development, Video &amp; photo, Music &amp; audio, or Other. It tells us who uses CacheDrop. It’s optional.</li>
<li><span style={lead}>News emails</span>, only if you tick the box. Then we also email you about new features, surveys and the paid launch. The box starts unticked. The download never depends on it.</li>
<li><span style={lead}>A code in your download link</span>. It lets the link work only for you. The link works for 7 days.</li>
<li><span style={lead}>Feedback</span> you send with the feedback form: your rating, your message, the page you sent it from, and your email if you add one. We use it to fix problems and decide what to build next.</li>
<li><span style={lead}>System specs</span>, only if you tick the box in the feedback form: what your browser reports about itself, which includes your macOS version, platform and language. They help us reproduce problems.</li>
<li><span style={lead}>Page visits</span>, counted by Vercel Web Analytics, which works without cookies. We remove the code from download links before a visit is counted.</li>
<li><span style={lead}>Download counts</span>, kept in our own database, not in analytics.</li>
<li><span style={lead}>Spam protection</span>. Cloudflare Turnstile checks that a form is sent by a person. We also use your IP address to limit how many forms can be sent from one place.</li>
</ul>
</section>

<section id="providers" style={section}>
<h2 style={h2}>Who handles your information</h2>
<p style={body}>We use these services to run the website. They are all outside Quebec, so the information they handle leaves Quebec.</p>
<ul style={list}>
<li><span style={lead}>Supabase</span> stores signups, feedback and the app download. Its servers are in the United States (Amazon Web Services). Outside Quebec.</li>
<li><span style={lead}>Vercel</span> hosts the website, runs the code behind its forms, and counts page visits. Outside Quebec.</li>
<li><span style={lead}>Resend</span> sends our emails. It receives your email address and the emails we send you. Outside Quebec.</li>
<li><span style={lead}>Cloudflare</span> runs the Turnstile spam check on our forms. It also forwards email sent to privacy@cachedrop.io and hello@cachedrop.io to our inbox, so those messages pass through Cloudflare. Outside Quebec.</li>
<li><span style={lead}>GitHub</span> holds our list of feedback about the app, in a private GitHub repository. Each piece of feedback becomes an issue with the rating, message, page and specs. It never includes your email. Outside Quebec.</li>
</ul>
</section>

<section id="retention" style={section}>
<h2 style={h2}>How long we keep it</h2>
<ul style={list}>
<li><span style={lead}>Signups</span>: your email, your answer about your Mac and your news choice. We keep them until you unsubscribe or ask us to delete it. Every email we send has an unsubscribe link.</li>
<li><span style={lead}>Download link codes</span>: a link stops working after 7 days. We delete its code 30 days after that.</li>
<li><span style={lead}>System specs</span>: we keep them with the feedback they came with, and delete them with it.</li>
</ul>
</section>

<section id="rights" style={section}>
<h2 style={h2}>Your rights</h2>
<p style={body}>You can ask us to:</p>
<ul style={list}>
<li>see the personal information we hold about you,</li>
<li>correct it,</li>
<li>withdraw your consent, for example to news emails,</li>
<li>delete it.</li>
</ul>
<p style={body}>Write to <a class="textlink" href="mailto:privacy@cachedrop.io" style={mail}>privacy@cachedrop.io</a>. If you aren’t happy with our answer, you can complain to Quebec’s Commission d’accès à l’information (cai.gouv.qc.ca).</p>
</section>

<section id="contact" style={section}>
<h2 style={h2}>Contact us</h2>
<p style={body}>Email: <a class="textlink" href="mailto:privacy@cachedrop.io" style={mail}>privacy@cachedrop.io</a></p>
<p data-placeholder="mailing-address" style="margin: var(--space-4) 0 0; padding: var(--space-3) var(--space-4); border: 1px dashed var(--danger-ink); border-radius: var(--radius-md); background: var(--danger-soft); font-size: 15px; line-height: 23px; color: var(--danger-ink)"><strong>Mailing address: placeholder.</strong> Our postal box address goes here before launch.</p>
</section>

</div>
</main>

<Footer />
</Base>
