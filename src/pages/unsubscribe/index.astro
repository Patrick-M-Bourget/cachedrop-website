---
// The unsubscribe page (Decision 4): every email links to /unsubscribe/<token>/, which vercel.json
// rewrites here. The script POSTs the token to /api/unsubscribe and confirms in one sentence. No
// preferences, no sign-in. Opening the page is the click: link scanners that only fetch the HTML
// unsubscribe nobody, since the GET itself changes nothing.
// The design system's utility-page recipe (handoff/design-system/README.md): IconTile lg, H1, lede.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const tile = 'width: var(--tile-lg); height: var(--tile-lg); border-radius: var(--radius-2xl); background: var(--surface-subtle); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--ink)';
const h1 = 'margin: var(--space-8) 0 0; font-size: clamp(34px, 4.6vw, 56px); line-height: 1.08; font-weight: 600; letter-spacing: -0.035em; text-wrap: balance';
const lede = 'margin: 18px 0 0; max-width: 560px; font-size: 19px; line-height: 29px; color: var(--ink-secondary); text-wrap: pretty';
const link = 'color: var(--accent-text); font-weight: 500';
const states = [
  { state: 'pending', title: 'Unsubscribing…', body: 'This takes a second.' },
  { state: 'done', title: 'You’re unsubscribed.', body: 'CacheDrop won’t send update or news emails to this address any more.' },
  { state: 'invalid', title: 'This unsubscribe link doesn’t work.', body: 'Use the link in your latest CacheDrop email, or write to' },
  { state: 'error', title: 'Something went wrong.', body: 'Reload the page to try again, or write to' },
];
---
<Base title="Unsubscribe from CacheDrop emails" description="Stop CacheDrop update and news emails." path="/unsubscribe/" robots="noindex, nofollow">
<style is:global>
[data-unsubscribe] [hidden]{display:none !important}
</style>
<Nav />

<main style="padding: 104px var(--space-6) var(--space-32)">
<div data-unsubscribe aria-live="polite" style="max-width: var(--window-max); margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center">
<div style={tile}>
<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3.5 6.5l8.5 6.5 8.5-6.5"></path></svg>
</div>
{states.map(({ state, title, body }) => (
<div data-state={state} hidden={state !== 'pending'}>
<h1 style={h1}>{title}</h1>
<p style={lede}>{body}{body.endsWith('write to') && <> <a class="textlink" href="mailto:hello@cachedrop.io" style={link}>hello@cachedrop.io</a>.</>}</p>
</div>
))}
</div>
</main>

<Footer overview />

<script is:inline>
(function () {
  var root = document.querySelector('[data-unsubscribe]');
  function show(state) {
    root.querySelectorAll('[data-state]').forEach(function (el) { el.hidden = el.getAttribute('data-state') !== state; });
  }
  var match = location.pathname.match(/^\/unsubscribe\/([A-Za-z0-9_-]{43})\/?$/);
  if (!match) return show('invalid');
  // The same request a mail client's one-click button makes (RFC 8058).
  fetch('/api/unsubscribe?token=' + match[1], {
    method: 'POST',
    headers: { 'content-type': 'application/x-www-form-urlencoded' },
    body: 'List-Unsubscribe=One-Click',
  })
    .then(function (res) { show(res.ok ? 'done' : res.status === 404 ? 'invalid' : 'error'); })
    .catch(function () { show('error'); });
})();
</script>
</Base>
