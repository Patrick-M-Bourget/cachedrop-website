---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AppWindow from '../components/AppWindow.astro';

const description =
  'Free up space on your Mac. CacheDrop finds hidden caches, Xcode DerivedData, node_modules and video caches, and clears them safely. Free beta.';

// One list feeds both the visible FAQ and the FAQPage JSON-LD, so they can't drift apart.
const faq = [
  ['What is CacheDrop?', 'CacheDrop is a native Mac storage cleaner for developers and video editors. It finds hidden caches, Xcode DerivedData, old node_modules folders and video editing caches, shows how much space each one takes, and clears what you approve.'],
  ['How do I free up space on my Mac?', 'Start with the files you can’t see. Caches, build files and render data can take tens of gigabytes, and macOS hides them inside “System Data”. CacheDrop scans for them, lets you review what it found, and clears it when you confirm.'],
  ['What is System Data on a Mac, and can I delete it?', 'System Data is where macOS counts files that don’t fit its other categories, including app caches, logs and developer build files. Much of it is safe to remove because apps rebuild it. CacheDrop only targets those rebuildable parts.'],
  ['Is it safe to delete caches on a Mac?', 'Yes, for caches that apps regenerate: the app simply rebuilds them the next time it needs them. CacheDrop recommends caches that rebuild themselves and shows you each one before anything is cleared.'],
  ['How do I clear my Mac’s disk without losing files?', 'Clear caches and build output, not documents. CacheDrop leaves your code, projects and timelines alone. It deletes only files apps make again, like caches, and sends your own files to the Trash.'],
  ['Is CacheDrop free, and which Macs does it support?', 'It’s free for a limited time during the public beta. It’s a universal app for Apple Silicon and Intel Macs running macOS 14 Sonoma or later.'],
];

const site = Astro.site!.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site}/#org`, name: 'CacheDrop', url: `${site}/`, logo: `${site}/assets/cachedrop-app-icon.png` },
    {
      '@type': 'SoftwareApplication',
      name: 'CacheDrop',
      url: `${site}/`,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'macOS 14 or later',
      description,
      publisher: { '@id': `${site}/#org` },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
    },
  ],
};

const card = 'background: var(--surface-raised); border: 1px solid var(--line); border-radius: var(--radius-2xl); padding: var(--space-8); box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: var(--space-6)';
const tile = 'width: var(--tile-md); height: var(--tile-md); border-radius: var(--radius-lg); background: var(--surface-subtle); display: flex; align-items: center; justify-content: center; color: var(--ink)';
const chip = 'font-size: 12px; color: var(--ink-body); background: var(--surface-subtle); border-radius: var(--radius-xs); padding: var(--space-1) var(--space-2)';
const chips = 'display: flex; flex-wrap: wrap; gap: var(--space-1-5); padding-top: var(--space-5); border-top: 1px solid var(--line)';
const cardTitle = 'margin: 0; font-size: 18px; line-height: 24px; font-weight: 600; letter-spacing: -0.01em';
const cardBody = 'margin: var(--space-2) 0 0; font-size: 15px; line-height: 23px; color: var(--ink-soft)';
const cardLink = 'display: inline-flex; align-items: center; gap: var(--space-1-5); font-size: 14px; font-weight: 500; color: var(--accent-text)';
const eyebrow = 'margin: 0 0 var(--space-3); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-secondary)';
const sectionH2 = 'margin: 0; font-size: clamp(28px, 3.4vw, 40px); line-height: 1.2; font-weight: 600; letter-spacing: -0.025em';
const primaryLg = 'display: inline-flex; align-items: center; gap: var(--space-2-5); height: var(--control-lg); padding: 0 var(--space-6); border-radius: var(--radius-full); background: var(--accent); font-size: 15px; font-weight: 500; box-shadow: var(--shadow-button)';
const steps = [
  ['01', 'Only what tools rebuild', 'Package caches, build files and render data that your apps regenerate on their own. Your code, projects and timelines stay put.'],
  ['02', 'You review first', 'Every recommendation shows its size and where it lives before anything moves.'],
  ['03', 'Your files go to the Trash', 'Caches that apps rebuild are deleted. Your files go to the Trash, so changing your mind is one drag away.'],
];
---
<Base title="Mac Storage Cleaner – Free Up Space on Your Mac | CacheDrop" description={description} path="/" jsonLd={jsonLd}>
<Nav homeHref="#top" />

<section id="top" style="max-width: var(--container-max); margin: 0 auto; padding: var(--space-28) var(--space-6) var(--space-32); display: flex; flex-direction: column; align-items: center; text-align: center">
<p style="margin: 0 0 var(--space-8); display: inline-flex; align-items: center; gap: var(--space-2); font-size: 12px; font-weight: 500; color: var(--ink-secondary); padding: var(--space-1-5) var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-full); background: var(--surface-elevated)">
<span aria-hidden="true" style="width: var(--dot); height: var(--dot); border-radius: var(--radius-full); background: var(--success)"></span>
<span>Free Mac storage cleaner · Public beta</span>
</p>
<h1 style="margin: 0; font-size: clamp(40px, 6vw, 76px); line-height: 1.04; font-weight: 600; letter-spacing: -0.04em; text-wrap: balance">Store less junk.<br>Keep what matters.</h1>
<h2 style="margin: var(--space-7) 0 0; max-width: var(--lede-max); font-size: 19px; line-height: 29px; font-weight: 400; letter-spacing: -0.012em; color: var(--ink-secondary); text-wrap: pretty">Your Mac is full of invisible caches, derived data, and abandoned project files. CacheDrop safely finds them and drops them. Free up space on your Mac in seconds.</h2>
<div id="download" style="margin-top: var(--space-10); display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-3)">
<a class="btn-primary" href="/download/" style={primaryLg}>
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
<span>Download Free Beta</span>
</a>
<a class="btn-ghost" href="#feedback" data-feedback style="display: inline-flex; align-items: center; height: var(--control-lg); padding: 0 22px; border-radius: var(--radius-full); border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); font-size: 15px; font-weight: 500">Give Fast Feedback</a>
</div>
<p style="margin: 18px 0 0; font-size: 13px; color: var(--ink-secondary)">Free for a limited time · Help us build it · macOS 14+ on Apple Silicon &amp; Intel</p>

<AppWindow />
</section>

<section id="features" style="background: var(--surface-subtle); padding: var(--space-30) var(--space-6)">
<div style="max-width: var(--container-max); margin: 0 auto">
<div style="max-width: var(--lede-max); margin-bottom: var(--space-14)">
<p style={eyebrow}>Built for workstations</p>
<h2 style={sectionH2}>Built for the heavy lifters.</h2>
<p style="margin: var(--space-4) 0 0; font-size: 17px; line-height: 27px; color: var(--ink-secondary); text-wrap: pretty">CacheDrop is a Mac storage cleaner made for developers and video editors. Generic cleaners clear browser cookies and miss the real weight. CacheDrop goes after compiler caches, media caches and stale container images: the files that grow quietly with every project.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: var(--space-6)">

<article id="developers" style={card}>
<div style={tile}>
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M7 10l3 2-3 2"></path><path d="M13 15h4"></path></svg>
</div>
<div style="flex: 1">
<h3 style={cardTitle}>Clear Developer Junk</h3>
<p style={cardBody}>Drop gigabytes of forgotten <span class="mono" style="font-size: 13px">node_modules</span>, Xcode DerivedData, and Docker caches safely.</p>
</div>
<div style={chips}>
{['node_modules', 'DerivedData', 'Docker images'].map((c) => <span class="mono" style={chip}>{c}</span>)}
</div>
<a class="textlink" href="/clear-mac-developer-caches/" style={cardLink}>How to clear developer caches
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
</article>

<article id="creators" style={card}>
<div style={tile}>
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M10 9.5v5l4.5-2.5z"></path></svg>
</div>
<div style="flex: 1">
<h3 style={cardTitle}>Clear Creator Caches</h3>
<p style={cardBody}>Clear hidden Adobe media caches and size up Final Cut Pro libraries full of render files, without losing your timelines.</p>
</div>
<div style={chips}>
{['.cfa / .pek', 'Media Cache', 'FCPX Libraries'].map((c) => <span class="mono" style={chip}>{c}</span>)}
</div>
<a class="textlink" href="/clear-adobe-media-cache-mac/" style={cardLink}>How to clear Adobe media cache
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
</article>

<article style={card}>
<div style={tile}>
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="10" rx="3"></rect><path d="M11 12h6"></path><path d="M7 12h.01"></path></svg>
</div>
<div style="flex: 1">
<h3 style={cardTitle}>Reclaim Mac Disk Space</h3>
<p style={cardBody}>Safely purge massive application logs, app caches, and leftover update downloads clogging your hard drive.</p>
</div>
<div style={chips}>
{['~/Library/Caches', '~/Library/Logs', 'Update downloads'].map((c) => <span class="mono" style={chip}>{c}</span>)}
</div>
</article>

</div>
</div>
</section>

<section style="padding: var(--space-32) var(--space-6)">
<div style="max-width: var(--container-max); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: var(--space-16); align-items: start">
<div>
<p style={eyebrow}>Careful by default</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>Nothing leaves your Mac without a look.</h2>
<p style="margin: var(--space-4) 0 0; max-width: 440px; font-size: 17px; line-height: 27px; color: var(--ink-secondary); text-wrap: pretty">Old-school cleaners run blunt scripts across standard folders. CacheDrop shows you what it found, why it’s safe to drop, and how much you’ll get back. Then it waits for you.</p>
</div>
<ol style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column">
{steps.map(([n, title, body], i) => (
<li style={`display: flex; gap: var(--space-6); padding: var(--space-7) 0; border-top: 1px solid var(--line)${i === steps.length - 1 ? '; border-bottom: 1px solid var(--line)' : ''}`}>
<span class="mono" style="flex: none; width: var(--control-xs); font-size: 13px; line-height: 24px; color: var(--ink-secondary)">{n}</span>
<div>
<h3 style={cardTitle}>{title}</h3>
<p style="margin: var(--space-1-5) 0 0; font-size: 15px; line-height: 23px; color: var(--ink-soft)">{body}</p>
</div>
</li>
))}
</ol>
</div>
</section>

<section id="faq" style="padding: 0 var(--space-6) var(--space-32)">
<div style="max-width: var(--container-max); margin: 0 auto; padding-top: var(--space-28); border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: var(--space-16); align-items: start">
<div>
<p style={eyebrow}>FAQ</p>
<h2 style={`${sectionH2}; text-wrap: balance`}>Mac storage, answered.</h2>
<p style="margin: var(--space-4) 0 0; max-width: 400px; font-size: 17px; line-height: 27px; color: var(--ink-secondary)">Still have a question? <a class="textlink" href="#feedback" data-feedback style="color: var(--accent-text)">Ask us directly</a>.</p>
</div>
<div style="display: flex; flex-direction: column">
{faq.map(([q, a], i) => (
<div style={`padding: var(--space-6) 0; border-top: 1px solid var(--line)${i === faq.length - 1 ? '; border-bottom: 1px solid var(--line)' : ''}`}>
<h3 style="margin: 0; font-size: 18px; line-height: 26px; font-weight: 600; letter-spacing: -0.01em">{q}</h3>
<p style="margin: var(--space-2) 0 0; font-size: 15px; line-height: 24px; color: var(--ink-soft)">{a}</p>
</div>
))}
</div>
</div>
</section>

<section style="background: var(--surface-subtle); padding: var(--space-30) var(--space-6); text-align: center">
<div style="max-width: 640px; margin: 0 auto; display: flex; flex-direction: column; align-items: center">
<h2 style="margin: 0; font-size: clamp(32px, 4.4vw, 52px); line-height: 1.1; font-weight: 600; letter-spacing: -0.035em">Get your space back.</h2>
<p style="margin: 18px 0 0; font-size: 17px; line-height: 27px; color: var(--ink-secondary)">Free while in beta. One universal app for Apple Silicon and Intel Macs on macOS 14 or later.</p>
<a class="btn-primary" href="/download/" style={`margin-top: 36px; ${primaryLg}`}>
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
<span>Download Free Beta</span>
</a>
<a class="textlink" href="#feedback" data-feedback style="margin-top: var(--space-5); font-size: 14px; color: var(--ink-body)">Using it already? Tell us what to fix next →</a>
</div>
</section>

<Footer />
</Base>
