---
// The download signup card (Decision 1): the email form and its "check your inbox" done state,
// which offers Open Gmail and Open Outlook and a link that sends the email again (Decision 53).
// Used by /download/ and by landing pages that take the signup without another click (Decision 48).
// The form posts to /api/signup, which saves the signup and emails a download link in `lang`.
// The news checkbox always starts unticked and the download never depends on it (Decision 3).
// Built from the design system's TextField, Checkbox, Button and done-state parts
// (handoff/design-system/components/bundle.css). One per page: its ids are fixed.
// The bot check (Decision 12) starts on load, so its token is ready by the time the email is typed.
import BotCheck from './BotCheck.astro';
import { titleMd } from './guide-styles';
import { localize, type Lang } from '../i18n';
import '../styles/gate.css';

interface Props {
  lang: Lang;
  /** Extra inline style for the card, such as its margin on the page. */
  style?: string;
}

const { lang, style = '' } = Astro.props;

const copy = {
  en: {
    filling: ['Development', 'Video & photo', 'Music & audio', 'Other'],
    email: 'Email',
    placeholder: 'you@example.com',
    filled: 'What’s filling your Mac?',
    optional: '(optional)',
    news: 'Email me news about CacheDrop, like new features and surveys.',
    newsNote: 'Optional. You can unsubscribe at any time from any of our emails.',
    send: 'Email Me the Link',
    promise: 'We email you the link, then only about new versions and security.',
    privacy: 'Privacy Policy',
    sentTitle: 'Check your inbox',
    sentBefore: 'We sent a download link to ',
    sentAfter: '. If it isn’t there in a minute, check your spam folder.',
    gmail: 'Open Gmail',
    outlook: 'Open Outlook',
    resendBefore: 'Didn’t get it?',
    resend: 'Send it again',
    resent: 'Sent again. It can take a minute to arrive.',
    again: 'Use a Different Email',
    badEmail: 'Enter a full email address, like you@example.com.',
    failed: 'We couldn’t send the link. Check your connection and try again.',
  },
  fr: {
    filling: ['Développement', 'Vidéo et photo', 'Musique et audio', 'Autre'],
    email: 'Courriel',
    placeholder: 'vous@exemple.com',
    filled: 'Qu’est-ce qui remplit votre Mac?',
    optional: '(facultatif)',
    news: 'Envoyez-moi des nouvelles de CacheDrop par courriel : nouvelles fonctionnalités et sondages.',
    newsNote: 'Facultatif. Vous pouvez vous désabonner en tout temps à partir de n’importe lequel de nos courriels.',
    send: 'M’envoyer le lien',
    promise: 'Nous vous envoyons le lien, puis seulement des courriels sur les nouvelles versions et la sécurité.',
    privacy: 'Politique de confidentialité',
    sentTitle: 'Vérifiez vos courriels',
    sentBefore: 'Nous avons envoyé un lien de téléchargement à ',
    sentAfter: '. S’il n’est pas arrivé d’ici une minute, vérifiez votre dossier de courrier indésirable.',
    gmail: 'Ouvrir Gmail',
    outlook: 'Ouvrir Outlook',
    resendBefore: 'Rien reçu?',
    resend: 'Renvoyer le lien',
    resent: 'Lien renvoyé. Il peut prendre une minute à arriver.',
    again: 'Utiliser une autre adresse',
    badEmail: 'Entrez une adresse courriel complète, comme vous@exemple.com.',
    failed: 'Le lien n’a pas pu être envoyé. Vérifiez votre connexion et réessayez.',
  },
};
const t = copy[lang];
const filling = ['development', 'video-photo', 'music-audio', 'other'].map((value, i) => [value, t.filling[i]]);
const msg = { lang, badEmail: t.badEmail, failed: t.failed, resent: t.resent };
// The done state's webmail buttons open the inbox in a new tab. Gmail searches every folder,
// spam included, for the sender (src/server/mail.ts); the script adds the address as authuser so
// Gmail opens that account when several are signed in. Outlook.com has no search link, so it opens the inbox.
const GMAIL = 'https://mail.google.com/mail/u/0/#search/from%3Ahello%40cachedrop.io+in%3Aanywhere';
const OUTLOOK = 'https://outlook.live.com/mail/0/';
const label = 'font-size: 13px; line-height: 18px; font-weight: 500';
---
<div data-gate style={`width: 100%; max-width: var(--modal-max); padding: var(--space-8); border: 1px solid var(--line); border-radius: var(--radius-2xl); background: var(--surface-raised); box-shadow: var(--shadow-card); text-align: left; ${style}`}>
<form data-gate-form novalidate style="display: flex; flex-direction: column; gap: var(--space-5); margin: 0">
<div style="display: flex; flex-direction: column; gap: var(--space-1-5)">
<label for="gate-email" style={label}>{t.email}</label>
<input id="gate-email" name="email" class="gate-input" type="email" autocomplete="email" required placeholder={t.placeholder} aria-describedby="gate-error">
<p id="gate-error" data-gate-error hidden role="alert" style="margin: 0; font-size: 13px; line-height: 18px; color: var(--danger-ink)"></p>
</div>
<fieldset style="margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: var(--space-2-5)">
<legend style={`padding: 0; margin-bottom: var(--space-2-5); ${label}`}>{t.filled} <span style="font-weight: 400; color: var(--ink-secondary)">{t.optional}</span></legend>
<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2-5) var(--space-4)">
{filling.map(([value, text]) => (
<label class="gate-check"><input type="radio" name="filling" value={value}><span>{text}</span></label>
))}
</div>
</fieldset>
<div>
<label class="gate-check"><input type="checkbox" name="news" aria-describedby="gate-news-note"><span>{t.news}</span></label>
<p id="gate-news-note" style="margin: var(--space-1) 0 0 calc(var(--space-4) + var(--space-2-5)); font-size: 13px; line-height: 18px; color: var(--ink-secondary)">{t.newsNote}</p>
</div>
<BotCheck form="signup" lang={lang} />
<button type="submit" class="gate-btn gate-primary">{t.send}</button>
<p style="margin: 0; font-size: 13px; line-height: 18px; color: var(--ink-secondary)">{t.promise} <a class="textlink" href={localize(lang, '/privacy/')} style="color: var(--accent-text); font-weight: 500">{t.privacy}</a></p>
</form>

<div data-gate-done hidden aria-live="polite" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-3); padding: var(--space-6) 0 var(--space-2)">
<div style="width: var(--control-lg); height: var(--control-lg); border-radius: var(--radius-full); background: var(--success-soft); color: var(--success-ink); display: flex; align-items: center; justify-content: center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></div>
<h2 data-gate-done-title tabindex="-1" style={`${titleMd}; outline: none`}>{t.sentTitle}</h2>
<p style="margin: 0; font-size: 14px; line-height: 20px; color: var(--ink-secondary)">{t.sentBefore}<span data-gate-sent-to style="font-weight: 500; color: var(--ink); overflow-wrap: anywhere"></span>{t.sentAfter}</p>
<div style="margin-top: var(--space-2); display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3)">
<a class="gate-btn gate-secondary" data-gate-gmail href={GMAIL} target="_blank" rel="noopener noreferrer">{t.gmail}</a>
<a class="gate-btn gate-secondary" data-gate-outlook href={OUTLOOK} target="_blank" rel="noopener noreferrer">{t.outlook}</a>
</div>
<p style="margin: var(--space-1) 0 0; font-size: 14px; line-height: 20px; color: var(--ink-secondary)">{t.resendBefore} <button type="button" class="textlink gate-link" data-gate-resend>{t.resend}</button></p>
<p data-gate-resend-status role="status" hidden style="margin: 0; font-size: 13px; line-height: 18px; color: var(--ink-secondary)"></p>
<button type="button" class="gate-btn gate-quiet" data-gate-again>{t.again}</button>
</div>
</div>

<script is:inline define:vars={{ msg }}>
(function () {
  var form = document.querySelector('[data-gate-form]');
  var done = document.querySelector('[data-gate-done]');
  var error = document.querySelector('[data-gate-error]');
  var status = document.querySelector('[data-gate-resend-status]');
  var resend = document.querySelector('[data-gate-resend]');
  var gmail = document.querySelector('[data-gate-gmail]');
  var check = form.querySelector('[data-bot-check]');
  var email = form.email;
  var submit = form.querySelector('[type=submit]');
  var gmailBase = gmail.getAttribute('href');
  // bot-check.js is deferred, so it runs after this and before DOMContentLoaded.
  document.addEventListener('DOMContentLoaded', function () { window.CacheDropBotCheck.prepare(check); });

  function fail(message, field) {
    error.textContent = message;
    error.hidden = false;
    if (field) { email.setAttribute('aria-invalid', 'true'); email.focus(); }
  }
  function clear() { error.hidden = true; email.removeAttribute('aria-invalid'); }
  var BAD_EMAIL = msg.badEmail;
  var NOT_SENT = msg.failed;

  // Posts one signup, then calls ok() or refused(message, isBadEmail). The resend link posts the
  // same answers again, so a second email goes out with a fresh link.
  function post(body, ok, refused) {
    var bot = window.CacheDropBotCheck;
    return bot.token(check)
      .then(function (token) {
        body.turnstile = token;
        return fetch('/api/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        }).then(function (res) {
          bot.reset(check); // a token works once
          if (res.ok) return ok();
          return res.json().catch(function () { return {}; }).then(function (answer) {
            var message = bot.message(check, res, answer);
            if (message) refused(message);
            else if (answer.error === 'invalid_email') refused(BAD_EMAIL, true);
            else refused(NOT_SENT);
          });
        }, function () { bot.reset(check); refused(NOT_SENT); });
      }, function () { refused(bot.failed(check)); });
  }

  var last = null;
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    clear();
    var address = email.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(address)) return fail(BAD_EMAIL, true);
    var choice = form.querySelector('[name=filling]:checked');
    last = { email: address, filling: choice ? choice.value : null, news: form.news.checked, lang: msg.lang, utm: window.cacheDropUtm ? window.cacheDropUtm() : undefined };
    submit.disabled = true;
    post(Object.assign({}, last), function () {
      document.querySelector('[data-gate-sent-to]').textContent = address;
      gmail.href = gmailBase.replace('/u/0/', '/u/?authuser=' + encodeURIComponent(address));
      status.hidden = true;
      form.hidden = true;
      done.hidden = false;
      document.querySelector('[data-gate-done-title]').focus();
    }, fail).then(function () { submit.disabled = false; });
  });
  email.addEventListener('input', clear);
  resend.addEventListener('click', function () {
    resend.disabled = true;
    status.hidden = true;
    post(Object.assign({}, last), function () {
      status.textContent = msg.resent;
      status.style.color = 'var(--ink-secondary)';
      status.hidden = false;
    }, function (message) {
      status.textContent = message;
      status.style.color = 'var(--danger-ink)';
      status.hidden = false;
    }).then(function () { resend.disabled = false; });
  });
  document.querySelector('[data-gate-again]').addEventListener('click', function () {
    form.reset();
    done.hidden = true;
    form.hidden = false;
    email.focus();
  });
})();
</script>
