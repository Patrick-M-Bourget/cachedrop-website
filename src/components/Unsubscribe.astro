---
// The unsubscribe page (Decision 4). `live` is the page every email links to, at
// /unsubscribe/<token>/ (vercel.json rewrites it to /unsubscribe/): its script POSTs the token to
// /api/unsubscribe and confirms in one sentence. No preferences, no sign-in. Opening the page is
// the click: link scanners that only fetch the HTML unsubscribe nobody, since the GET itself
// changes nothing. Without JavaScript it shows a confirm button instead, whose form POSTs to
// /unsubscribe/<token>/confirm; the API then redirects to one of the result pages (`done`,
// `invalid`, `error`), which show their state with no script.
// The design system's utility-page recipe (handoff/design-system/README.md): IconTile lg, H1, lede.
// Built in English and French (Decision 5); French emails link to /fr/unsubscribe/<token>/.
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { langOf } from '../i18n';

export type State = 'pending' | 'done' | 'invalid' | 'error';
interface Props {
  /** `live` runs the unsubscribe; a result state is shown as it is. */
  state: 'live' | Exclude<State, 'pending'>;
}
const { state: shown } = Astro.props;
const live = shown === 'live';

const tile = 'width: var(--tile-lg); height: var(--tile-lg); border-radius: var(--radius-2xl); background: var(--surface-subtle); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--ink)';
const h1 = 'margin: var(--space-8) 0 0; font-size: clamp(34px, 4.6vw, 56px); line-height: 1.08; font-weight: 600; letter-spacing: -0.035em; text-wrap: balance';
const lede = 'margin: 18px 0 0; max-width: 560px; font-size: 19px; line-height: 29px; color: var(--ink-secondary); text-wrap: pretty';
const link = 'color: var(--accent-text); font-weight: 500';
const button = 'margin-top: var(--space-8); height: var(--control-md); padding: 0 var(--space-5); border: 0; border-radius: var(--radius-full); background: var(--accent); color: var(--on-accent); box-shadow: var(--shadow-button); font: inherit; font-size: 15px; font-weight: 500; cursor: pointer';
// `write` states end with "write to hello@cachedrop.io."
const copy = {
  en: {
    title: 'Unsubscribe from CacheDrop emails',
    description: 'Stop CacheDrop update and news emails.',
    states: [
      { state: 'pending', title: 'Unsubscribing…', body: 'This takes a second.' },
      { state: 'done', title: 'You’re unsubscribed.', body: 'CacheDrop won’t send update or news emails to this address any more.' },
      { state: 'invalid', title: 'This unsubscribe link doesn’t work.', body: 'Use the link in your latest CacheDrop email, or write to', write: true },
      { state: 'error', title: 'Something went wrong.', body: 'Reload the page to try again, or write to', write: true },
    ],
    confirm: { title: 'Unsubscribe from CacheDrop emails', body: 'Confirm to stop update and news emails to this address.', button: 'Unsubscribe' },
  },
  fr: {
    title: 'Se désabonner des courriels de CacheDrop',
    description: 'Ne plus recevoir les courriels de mises à jour et de nouvelles de CacheDrop.',
    states: [
      { state: 'pending', title: 'Désabonnement en cours…', body: 'Ça ne prend qu’une seconde.' },
      { state: 'done', title: 'Désabonnement confirmé.', body: 'CacheDrop n’enverra plus de courriels de mises à jour ni de nouvelles à cette adresse.' },
      { state: 'invalid', title: 'Ce lien de désabonnement ne fonctionne pas.', body: 'Utilisez le lien de votre plus récent courriel de CacheDrop, ou écrivez à', write: true },
      { state: 'error', title: 'Un problème est survenu.', body: 'Rechargez la page pour réessayer, ou écrivez à', write: true },
    ],
    confirm: { title: 'Se désabonner des courriels de CacheDrop', body: 'Confirmez pour ne plus recevoir de courriels de mises à jour ni de nouvelles à cette adresse.', button: 'Me désabonner' },
  },
};
const t = copy[langOf(Astro.url)];
// The live page shows nothing until its script picks a state, so a browser without JavaScript
// sees only the confirm form.
const states = live ? t.states : t.states.filter((s) => s.state === shown);
const path = live ? '/unsubscribe/' : `/unsubscribe/${shown}/`;
---
<Base title={t.title} description={t.description} path={path} robots="noindex, nofollow">
<style is:global>
[data-unsubscribe] [hidden]{display:none !important}
</style>
<Nav />

<main style="padding: 104px var(--space-6) var(--space-32)">
<div data-unsubscribe aria-live="polite" style="max-width: var(--window-max); margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center">
<div style={tile}>
<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3.5 6.5l8.5 6.5 8.5-6.5"></path></svg>
</div>
{states.map(({ state, title, body, write }) => (
<div data-state={state} hidden={live}>
<h1 style={h1}>{title}</h1>
<p style={lede}>{body}{write && <> <a class="textlink" href="mailto:hello@cachedrop.io" style={link}>hello@cachedrop.io</a>.</>}</p>
</div>
))}
{live && (
<noscript>
<form method="post" action="confirm" style="display: flex; flex-direction: column; align-items: center">
<h1 style={h1}>{t.confirm.title}</h1>
<p style={lede}>{t.confirm.body}</p>
<button type="submit" class="btn-primary" style={button}>{t.confirm.button}</button>
</form>
</noscript>
)}
</div>
</main>

<Footer path="/unsubscribe/" overview />

{live && (
<script is:inline>
(function () {
  var root = document.querySelector('[data-unsubscribe]');
  function show(state) {
    root.querySelectorAll('[data-state]').forEach(function (el) { el.hidden = el.getAttribute('data-state') !== state; });
  }
  show('pending');
  var match = location.pathname.match(/^(?:\/fr)?\/unsubscribe\/([A-Za-z0-9_-]{43})\/?$/);
  if (!match) return show('invalid');
  // The same request a mail client's one-click button makes (RFC 8058).
  fetch('/api/unsubscribe?token=' + match[1], {
    method: 'POST',
    headers: { 'content-type': 'application/x-www-form-urlencoded' },
    body: 'List-Unsubscribe=One-Click',
  })
    .then(function (res) { show(res.ok ? 'done' : res.status === 404 ? 'invalid' : 'error'); })
    .catch(function () { show('error'); });
})();
</script>
)}
</Base>
