---
// The pricing section (Decision 44): a homepage section between "Careful by default" and the FAQ,
// and the body of /pricing/ (as its H1). Built from the homepage's own parts: the section header
// (eyebrow, headline-lg), a feature card, the large primary and secondary buttons and the
// step list's ruled rows. The struck-through price is hidden from screen readers, which hear
// `spoken` ("Was $29.99, now $19.99 for a limited time, one-time.") instead. While the offer runs,
// a "Limited-time price" pill sits above the price (Decision 47). The Buy button reads
// "Buy · $29.99 once" (Decision 51); during the offer the regular price is struck through before the
// offer, and screen readers hear "Buy · was $29.99 now $19.99 once". The copy leads with what
// CacheDrop does, then the price (#113); the compare page link shows once that page is live (`compareLive`).
import { card, eyebrow, primaryLg, secondaryLg, sectionH2 } from './guide-styles';
import { buyHref, compareLive, discounted, pricingCopy } from './pricing';
import { langOf, localize } from '../i18n';

interface Props {
  /** 1 on /pricing/, where the title is the page's H1; 2 on the homepage. */
  level?: 1 | 2;
}
const { level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
const lang = langOf(Astro.url);
const t = pricingCopy[lang];
const legalPaths = ['/terms-of-sale/', '/refund-policy/', '/license-agreement/'];
const textLink = 'color: var(--accent-text); font-weight: 500';
---
<section id="pricing" aria-labelledby="pricing-title" style={`padding: ${level === 1 ? 'var(--space-28)' : '0'} var(--space-6) var(--space-32)`}>
<div style={`max-width: var(--container-max); margin: 0 auto; ${level === 1 ? '' : 'padding-top: var(--space-28); border-top: 1px solid var(--line); '}display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: var(--space-16); align-items: start`}>
<div>
<p style={eyebrow}>{t.eyebrow}</p>
<Heading id="pricing-title" style={`${sectionH2}; text-wrap: balance`}>{t.title}</Heading>
<p style="margin: var(--space-4) 0 0; max-width: 440px; font-size: 17px; line-height: 27px; color: var(--ink-secondary); text-wrap: pretty">{t.body}</p>
{compareLive[lang] && <p style="margin: var(--space-4) 0 0"><a class="textlink" data-compare href={localize(lang, '/compare/')} style="display: inline-flex; align-items: center; gap: var(--space-1-5); font-size: 14px; font-weight: 500; color: var(--accent-text)">{t.compare}
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a></p>}
</div>
<article aria-labelledby="pricing-name" style={card}>
<div>
<h3 id="pricing-name" style={eyebrow}>{t.name}</h3>
{discounted && <p aria-hidden="true" style="margin: 0 0 var(--space-3); display: inline-flex; font-size: 13px; line-height: 19px; font-weight: 500; color: var(--success-ink); background: var(--success-soft); border-radius: var(--radius-full); padding: var(--space-1) var(--space-3)">{t.limited}</p>}
<p data-price style="margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3)">
<span class="sr-only">{t.spoken}</span>
<s aria-hidden="true" style="font-size: 20px; color: var(--ink-secondary)">{t.was}</s>
<span aria-hidden="true" style="font-size: clamp(40px, 5vw, 52px); line-height: 1.04; font-weight: 600; letter-spacing: -0.035em">{t.now}</span>
<span aria-hidden="true" style="font-size: 15px; color: var(--ink-secondary)">{t.once}</span>
</p>
<p style="margin: var(--space-3) 0 0; font-size: 13px; line-height: 19px; color: var(--ink-secondary)">{t.currencies}</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: var(--space-3)">
<a class="btn-primary" href={buyHref(lang)} style={primaryLg}><span>{t.buy} ·{discounted && <> <span class="sr-only">{t.wasWord}</span>{' '}<s>{t.was}</s> <span class="sr-only">{t.nowWord}</span></>} {t.now}{t.buyOnce && ` ${t.buyOnce}`}</span></a>
<a class="btn-ghost" href={localize(lang, '/download/')} style={secondaryLg}>{t.download}</a>
</div>
<ul aria-label={t.included} style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column">
{t.items.map((item) => (
<li style="display: flex; gap: var(--space-3); padding: var(--space-3) 0; border-top: 1px solid var(--line); font-size: 15px; line-height: 23px; color: var(--ink-soft)">
<svg style="flex: none; margin-top: var(--space-0-5); color: var(--success-ink)" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
<span>{item}</span>
</li>
))}
</ul>
<p style="margin: 0; font-size: 13px; line-height: 19px; color: var(--ink-secondary)">
{t.legal.map((part, i) => (i % 2 ? <a class="textlink" href={localize(lang, legalPaths[(i - 1) / 2])} style={textLink}>{part}</a> : part))}
</p>
</article>
</div>
</section>
