---
// "On this page" box at the top of a guide. Links are styled by `.toc a` in the Guide layout.
import { langOf } from '../i18n';

interface Props {
  items: Array<[href: string, label: string]>;
}
const { items } = Astro.props;
const title = { en: 'On this page', fr: 'Sur cette page' }[langOf(Astro.url)];
---
<nav class="toc" aria-label={title} style="padding: var(--space-6) var(--space-7); border: 1px solid var(--line); border-radius: var(--radius-2xl)">
<p style="margin: 0 0 var(--space-3); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-secondary)">{title}</p>
<ol style="margin: 0; padding: 0 0 0 var(--space-5); display: flex; flex-direction: column; gap: var(--space-2); font-size: 15px; line-height: 22px">
{items.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
</ol>
</nav>
