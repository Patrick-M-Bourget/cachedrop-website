---
// A legal page (Decision 43): the privacy page's layout, with hero, breadcrumb, "On this page"
// and its sections, for the terms of sale, the refund policy and the license agreement.
// The page passes its copy in its own language. Paragraphs and list items are HTML.
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Toc from '../components/Toc.astro';
import { guideH2, guideP } from '../components/guide-styles';
import type { LegalSection } from '../components/legal';
import { langOf, localize } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** English path, e.g. `/terms-of-sale/`. */
  path: string;
  /** The H1, also the breadcrumb and BreadcrumbList name. */
  crumb: string;
  lede: string;
  /** Visible "Updated …" month in the page's language. */
  updated: string;
  sections: LegalSection[];
}

const { title, description, path, crumb, lede, updated, sections } = Astro.props;
const lang = langOf(Astro.url);
const breadcrumb = { en: 'Breadcrumb', fr: 'Fil d’Ariane' }[lang];

const site = Astro.site!.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'CacheDrop', item: `${site}${localize(lang, '/')}` },
    { '@type': 'ListItem', position: 2, name: crumb, item: `${site}${localize(lang, path)}` },
  ],
};

const toc = sections.map((s): [string, string] => [`#${s.id}`, s.title]);
const body = `${guideP}; margin-top: var(--space-4); text-wrap: pretty`;
const list = 'margin: var(--space-4) 0 0; padding: 0 0 0 var(--space-5); display: flex; flex-direction: column; gap: var(--space-2-5); font-size: 17px; line-height: 28px; color: var(--ink-body)';
const lead = 'font-weight: 600; color: var(--ink)';
---
<Base title={title} description={description} path={path} jsonLd={jsonLd}>
<style is:global>
.toc a{color:var(--ink-body)}
.toc a:hover{color:var(--accent-text)}
</style>
<Nav current={path} />

<main>
<section style="background: var(--surface-elevated); border-bottom: 1px solid var(--line); padding: var(--space-18) var(--space-6) var(--space-22)">
<div style="max-width: var(--reading-max); margin: 0 auto">
<nav aria-label={breadcrumb}>
<ol style="margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-size: 13px; color: var(--ink-secondary)">
<li><a class="flink" href={localize(lang, '/')}>CacheDrop</a></li>
<li aria-hidden="true" style="display: flex"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg></li>
<li aria-current="page" style="color: var(--ink-body)">{crumb}</li>
</ol>
</nav>
<h1 style="margin: var(--space-10) 0 0; font-size: clamp(38px, 5.4vw, 64px); line-height: 1.06; font-weight: 600; letter-spacing: -0.04em; text-wrap: balance">{crumb}</h1>
<p style="margin: var(--space-6) 0 0; font-size: 19px; line-height: 29px; font-weight: 400; letter-spacing: -0.012em; color: var(--ink-secondary); text-wrap: pretty">{lede}</p>
<p style="margin: var(--space-10) 0 0; font-size: 13px; color: var(--ink-secondary)">{updated}</p>
</div>
</section>

<div style="max-width: var(--reading-max); margin: 0 auto; padding: var(--space-18) var(--space-6) var(--space-30)">
<Toc items={toc} />

{sections.map((s, i) => (
<section id={s.id} style={`padding-top: var(${i === 0 ? '--space-16' : '--space-18'})`}>
<h2 style={guideH2}>{s.title}</h2>
{s.body.map((b) => typeof b === 'string'
  ? <p style={body} set:html={b}></p>
  : <ul style={list}>{b.map((item) => typeof item === 'string'
      ? <li set:html={item}></li>
      : <li><span style={lead}>{item[0]}</span><Fragment set:html={item[1]} /></li>)}</ul>)}
</section>
))}
</div>
</main>

<Footer path={path} />
</Base>
